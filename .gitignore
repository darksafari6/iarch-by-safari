# Python bytecode and runtime caches
__pycache__/
*.py[cod]

# Virtual environments used only for local tooling (shellcheck, svg preview)
.venv/
venv/

# Timestamped backups created by the installers and runtime helpers.
# They are recovery data on the machine that made them, never repository content.
*.bak.*
*.backup.*

# Session and installer logs written under $XDG_STATE_HOME on target machines,
# kept out of the repository if someone runs a script from inside a checkout.
*.log

# Editor and OS noise
.DS_Store
*~
*.swp
