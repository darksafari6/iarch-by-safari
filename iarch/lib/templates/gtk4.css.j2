  iArch by Safari — GTK 4 glass overlay.
  Copyright (C) 2026 Safari — GPL-3.0-or-later

  Rendered by iarch/cli/render_gtk_css.py into ~/.config/gtk-4.0/gtk.css.
  Every property, shorthand, at-rule, pseudo-class, colour function, filter
  function, node name and style class used here is one that GTK
  {{ verified.gtk4 }} or libadwaita {{ verified.libadwaita }} parses, as
  recorded in data/design/gtk.json; the renderer refuses to write a sheet that
  uses anything else, because GTK only warns about a property it does not know
  and quietly keeps a selector that matches nothing.

  GTK CSS has no !important, so this file wins on cascade order: it is parsed
  after the theme. Rules that have to beat libadwaita carry at least its
  specificity.

  Colours come from the {{ preset }} palette and every opacity, radius, border
  width, duration and easing from the {{ intensity }} intensity in
  data/design/tokens.json. Nothing here is a number this template chose.
-#}
{%- macro alpha(color, value) -%}alpha({{ color }}, {{ value }}){%- endmacro -%}
{%- macro ring(width) -%}
  outline-color: {{ alpha(c.accent, 0.55) }};
  outline-style: solid;
  outline-width: {{ width }}px;
  outline-offset: -{{ width }}px;
{%- endmacro -%}
{%- macro transition(props, duration, easing) -%}
  transition-property: {{ props }};
  transition-duration: {{ duration }}ms;
  transition-timing-function: {{ easing }}
{%- endmacro -%}
{%- macro shadow(y, blur, alpha_value) -%}0 {{ y }}px {{ blur }}px {{ alpha(c.shadow, alpha_value) }}{%- endmacro -%}

/* ---- the roles this sheet uses, defined once ---------------------------- */
@define-color iarch_accent {{ c.accent }};
@define-color iarch_on_accent {{ c.on_accent }};
@define-color iarch_surface {{ c.surface }};
@define-color iarch_border {{ alpha(c.outline_variant, g.border_alpha) }};
@define-color iarch_highlight {{ alpha('#ffffff', g.highlight_alpha) }};

/* ---- windows, header bars and the client-side decoration --------------- */

window.background {
  background-color: {{ alpha(c.background, o.window) }};
  color: {{ c.on_surface }};
{% if blur_enabled %}  backdrop-filter: blur({{ blur_px }}px);
{% endif %}  {{ transition(t.window, m.fast, m.standard) }};
}

/* A solid fallback for the surfaces that must never be see-through. */
window.background.solid-csd,
window.background.opaque {
  background-color: {{ c.background }};
{% if blur_enabled %}  backdrop-filter: none;
{% endif %}}

/* GTK 4 has no decoration node -- gtkwindow.c sets only "window", and the
   default theme keeps just the .default-decoration class -- so the corner
   radius and the hairline live on the window itself. The drop shadow is the
   compositor's: decoration:shadow in .config/hypr/generated/glass.lua owns it,
   and drawing a second shadow here would double it under a tiling compositor. */
window.background {
  border-radius: {{ r.window }}px;
  box-shadow: inset 0 0 0 {{ border }}px {{ alpha(c.outline_variant, g.border_alpha) }};
}

window.background:backdrop {
  box-shadow: inset 0 0 0 {{ border }}px {{ alpha(c.outline_variant, g.backdrop_border_alpha) }};
}

window.maximized,
window.fullscreen,
window.tiled {
  border-radius: 0;
}

headerbar,
.titlebar {
  background-color: {{ alpha(c.surface, o.headerbar) }};
  background-image: linear-gradient(to bottom,
                      {{ alpha('#ffffff', g.highlight_alpha) }},
                      {{ alpha('#ffffff', 0) }} {{ sh.headerbar_highlight_stop }}px);
  border-bottom: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.window }}px {{ r.window }}px 0 0;
  box-shadow: none;
  min-height: {{ sh.headerbar_min_height }}px;
  {{ transition(t.fill_border, m.fast, m.standard) }};
}

headerbar:backdrop,
.titlebar:backdrop {
  background-color: {{ alpha(c.surface, o.window) }};
  color: {{ c.text_disabled }};
}

/* The window's own title stays legible over a translucent bar. */
headerbar windowhandle .title,
.titlebar windowhandle .title {
  color: {{ c.on_surface }};
  font-weight: {{ sh.title_weight }};
}

headerbar windowhandle .subtitle,
.titlebar windowhandle .subtitle {
  color: {{ c.on_surface_variant }};
  font-size: {{ sh.subtitle_size }}px;
}

/* ---- sidebars: more opaque than the window they sit in ----------------- */

.sidebar,
.navigation-sidebar,
placessidebar,
stacksidebar,
list.navigation-sidebar {
  background-color: {{ alpha(c.surface, o.sidebar) }};
  border-right: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  color: {{ c.on_surface }};
}

.sidebar:dir(rtl),
.navigation-sidebar:dir(rtl),
placessidebar:dir(rtl) {
  border-right: none;
  border-left: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
}

.sidebar:backdrop,
.navigation-sidebar:backdrop {
  background-color: {{ alpha(c.surface, o.window) }};
}

/* ---- buttons ----------------------------------------------------------- */

button {
  background-color: {{ alpha(c.surface_variant, o.button) }};
  background-image: linear-gradient(to bottom,
                      {{ alpha('#ffffff', g.highlight_alpha) }},
                      {{ alpha('#ffffff', 0) }} {{ sh.button_highlight_stop }}px);
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.button }}px;
  color: {{ c.on_surface }};
  padding: {{ sp.button_y }}px {{ sp.button_x }}px;
  box-shadow: {{ shadow(1, 2, sh.low_alpha) }};
  {{ transition(t.press, m.fast, m.standard) }};
}

button:hover {
  background-color: {{ alpha(c.surface_variant, o.card) }};
  border-color: {{ alpha(c.outline_variant, g.strong_border_alpha) }};
}

button:active,
button:checked {
  background-color: {{ alpha(c.surface_variant, o.sidebar) }};
  box-shadow: none;
  transform: scale({{ sh.press_scale }});
}

button:focus-visible {
  {{ ring(border) }}
}

button:disabled {
  background-color: {{ alpha(c.surface_variant, o.window) }};
  background-image: none;
  border-color: {{ alpha(c.outline_variant, g.backdrop_border_alpha) }};
  box-shadow: none;
  color: {{ c.text_disabled }};
  opacity: {{ sh.disabled_opacity }};
}

button.flat {
  background-color: {{ alpha(c.surface, 0) }};
  background-image: none;
  border-color: {{ alpha(c.outline_variant, 0) }};
  box-shadow: none;
}

button.flat:hover {
  background-color: {{ alpha(c.surface_variant, g.tint_alpha) }};
  border-color: {{ alpha(c.outline_variant, 0) }};
}

button.flat:active,
button.flat:checked {
  background-color: {{ alpha(c.surface_variant, g.tint_alpha_strong) }};
}

button.flat:disabled {
  background-color: {{ alpha(c.surface, 0) }};
  color: {{ c.text_disabled }};
  opacity: {{ sh.disabled_opacity }};
}

button.pill {
  border-radius: {{ r.pill_clamped }}px;
  padding: {{ sp.pill_y }}px {{ sp.pill_x }}px;
}

button.circular {
  border-radius: {{ r.pill_clamped }}px;
  padding: {{ sp.circular }}px;
  min-width: {{ sh.circular_min }}px;
  min-height: {{ sh.circular_min }}px;
}

/* A linked group shares one outline and rounds only its outer corners. */
.linked > button {
  border-radius: 0;
  border-right-width: 0;
}

.linked > button:first-child {
  border-radius: {{ r.button }}px 0 0 {{ r.button }}px;
  border-right-width: 0;
}

.linked > button:last-child {
  border-radius: 0 {{ r.button }}px {{ r.button }}px 0;
  border-right-width: {{ border }}px;
}

.linked > button:only-child {
  border-radius: {{ r.button }}px;
  border-right-width: {{ border }}px;
}

button.suggested-action {
  background-color: {{ alpha(c.accent, o.button) }};
  background-image: linear-gradient(to bottom,
                      {{ alpha('#ffffff', g.highlight_alpha) }},
                      {{ alpha('#ffffff', 0) }} {{ sh.button_highlight_stop }}px);
  border-color: {{ alpha(c.accent, g.strong_border_alpha) }};
  color: {{ c.on_accent }};
  box-shadow: 0 0 {{ sh.glow_px }}px {{ alpha(c.accent, sh.glow_alpha) }},
              {{ shadow(1, 2, sh.low_alpha) }};
}

button.suggested-action:hover {
  background-color: {{ alpha(c.accent, o.card) }};
  box-shadow: 0 0 {{ sh.glow_hover_px }}px {{ alpha(c.accent, sh.glow_hover_alpha) }};
}

button.suggested-action:active {
  background-color: {{ alpha(c.accent, o.sidebar) }};
  box-shadow: 0 0 {{ sh.glow_px }}px {{ alpha(c.accent, sh.glow_alpha) }};
}

button.suggested-action:disabled {
  background-color: {{ alpha(c.accent, sh.disabled_accent_alpha) }};
  background-image: none;
  border-color: {{ alpha(c.outline_variant, g.backdrop_border_alpha) }};
  box-shadow: none;
  color: {{ c.text_disabled }};
}

button.destructive-action {
  background-color: {{ alpha(c.danger, o.button) }};
  border-color: {{ alpha(c.danger, g.strong_border_alpha) }};
  color: {{ c.on_accent }};
  box-shadow: {{ shadow(1, 2, sh.low_alpha) }};
}

button.destructive-action:hover {
  background-color: {{ alpha(c.danger, o.card) }};
}

button.destructive-action:active {
  background-color: {{ alpha(c.danger, o.sidebar) }};
}

button.destructive-action:disabled {
  background-color: {{ alpha(c.danger, sh.disabled_accent_alpha) }};
  box-shadow: none;
  color: {{ c.text_disabled }};
}

/* ---- text entry, spin button and search -------------------------------- */

entry,
spinbutton {
  background-color: {{ alpha(c.surface_variant, o.input) }};
  background-image: none;
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.input }}px;
  color: {{ c.on_surface }};
  caret-color: {{ c.accent }};
  padding: {{ sp.entry_y }}px {{ sp.entry_x }}px;
  {{ transition(t.entry, m.fast, m.standard) }};
}

entry:hover,
spinbutton:hover {
  background-color: {{ alpha(c.surface_variant, o.button) }};
  border-color: {{ alpha(c.outline_variant, g.strong_border_alpha) }};
}

entry:focus-within,
spinbutton:focus-within {
  border-color: {{ alpha(c.accent, g.strong_border_alpha) }};
  {{ ring(border) }}
}

entry:disabled,
spinbutton:disabled {
  background-color: {{ alpha(c.surface_variant, o.window) }};
  color: {{ c.text_disabled }};
  opacity: {{ sh.disabled_opacity }};
}

entry > text > placeholder,
entry placeholder {
  color: {{ c.text_disabled }};
  opacity: {{ sh.placeholder_opacity }};
}

entry > text > selection,
textview text selection,
text selection {
  background-color: {{ alpha(c.accent, sh.selection_alpha) }};
  color: {{ c.on_surface }};
}

searchbar > revealer > box {
  background-color: {{ alpha(c.surface, o.headerbar) }};
  border-bottom: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  box-shadow: none;
}

/* ---- switch, check box and radio button -------------------------------- */

switch {
  background-color: {{ alpha(c.surface_variant, o.button) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.pill_clamped }}px;
  color: {{ c.on_surface_variant }};
  {{ transition(t.indicator, m.fast, m.standard) }};
}

switch:checked {
  background-color: {{ alpha(c.accent, sh.switch_checked_alpha) }};
  border-color: {{ alpha(c.accent, g.strong_border_alpha) }};
  color: {{ c.on_accent }};
}

switch:disabled {
  opacity: {{ sh.disabled_opacity }};
}

switch slider,
switch image {
  background-color: {{ c.surface }};
  border-radius: {{ r.pill_clamped }}px;
  box-shadow: {{ shadow(1, 3, sh.low_alpha) }};
}

switch:checked slider {
  background-color: {{ c.on_accent }};
}

check,
radio {
  background-color: {{ alpha(c.surface_variant, o.input) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.strong_border_alpha) }};
  color: {{ c.on_surface_variant }};
  min-width: {{ sh.indicator_min }}px;
  min-height: {{ sh.indicator_min }}px;
  {{ transition(t.indicator, m.fast, m.standard) }};
}

check {
  border-radius: {{ r.check }}px;
}

radio {
  border-radius: {{ r.pill_clamped }}px;
}

check:hover,
radio:hover {
  border-color: {{ alpha(c.accent, g.strong_border_alpha) }};
}

check:checked,
check:indeterminate,
radio:checked {
  background-color: {{ alpha(c.accent, sh.indicator_checked_alpha) }};
  border-color: {{ alpha(c.accent, g.strong_border_alpha) }};
  color: {{ c.on_accent }};
}

check:focus-visible,
radio:focus-visible,
switch:focus-visible {
  {{ ring(border) }}
}

check:disabled,
radio:disabled {
  opacity: {{ sh.disabled_opacity }};
}

/* ---- scales, progress bars and level bars ------------------------------ */

scale trough {
  background-color: {{ alpha(c.surface_variant, o.button) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.pill_clamped }}px;
  min-height: {{ sh.scale_trough }}px;
  min-width: {{ sh.scale_trough }}px;
}

scale highlight {
  background-color: {{ alpha(c.accent, sh.fill_alpha) }};
  border-radius: {{ r.pill_clamped }}px;
}

scale slider {
  background-color: {{ c.surface }};
  border: {{ border }}px solid {{ alpha(c.accent, g.strong_border_alpha) }};
  border-radius: {{ r.pill_clamped }}px;
  box-shadow: {{ shadow(1, 3, sh.low_alpha) }};
  min-width: {{ sh.scale_slider }}px;
  min-height: {{ sh.scale_slider }}px;
  {{ transition(t.press, m.fast, m.standard) }};
}

scale slider:hover {
  background-color: {{ alpha(c.accent, sh.slider_hover_alpha) }};
}

scale slider:active {
  box-shadow: 0 0 {{ sh.glow_px }}px {{ alpha(c.accent, sh.glow_alpha) }};
}

scale:focus-visible slider {
  {{ ring(border) }}
}

scale:disabled trough,
scale:disabled highlight,
scale:disabled slider {
  opacity: {{ sh.disabled_opacity }};
}

progressbar trough {
  background-color: {{ alpha(c.surface_variant, o.button) }};
  border-radius: {{ r.pill_clamped }}px;
  min-height: {{ sh.progress_min }}px;
}

progressbar progress {
  background-color: {{ alpha(c.accent, sh.fill_alpha) }};
  border-radius: {{ r.pill_clamped }}px;
}

levelbar block {
  border-radius: {{ r.check }}px;
  background-color: {{ alpha(c.accent, sh.fill_alpha) }};
}

levelbar block.low {
  background-color: {{ alpha(c.warning, sh.fill_alpha) }};
}

levelbar block.high,
levelbar block.full {
  background-color: {{ alpha(c.success, sh.fill_alpha) }};
}

levelbar block.empty {
  background-color: {{ alpha(c.surface_variant, o.button) }};
}

/* ---- scroll bars ------------------------------------------------------- */

scrollbar {
  background-color: {{ alpha(c.surface, 0) }};
  border: none;
  padding: {{ sp.scrollbar }}px;
}

scrollbar slider {
  background-color: {{ alpha(c.on_surface_variant, sh.scrollbar_alpha) }};
  border: none;
  border-radius: {{ r.pill_clamped }}px;
  min-width: {{ sh.scrollbar_min }}px;
  min-height: {{ sh.scrollbar_min }}px;
  {{ transition('background-color', m.fast, m.standard) }};
}

scrollbar slider:hover {
  background-color: {{ alpha(c.on_surface_variant, sh.scrollbar_hover_alpha) }};
}

scrollbar slider:active {
  background-color: {{ alpha(c.accent, sh.fill_alpha) }};
}

scrollbar.overlay-indicator slider {
  background-color: {{ alpha(c.on_surface_variant, sh.scrollbar_overlay_alpha) }};
}

junction,
scrollbar undershoot.top,
scrollbar undershoot.bottom,
scrollbar undershoot.left,
scrollbar undershoot.right,
scrolledwindow overshoot.top,
scrolledwindow overshoot.bottom {
  background-color: {{ alpha(c.surface, 0) }};
  background-image: none;
  border: none;
  box-shadow: none;
}

/* ---- notebooks, tab bars and tab views --------------------------------- */

notebook > header {
  background-color: {{ alpha(c.surface, o.headerbar) }};
  border: none;
  box-shadow: inset 0 -{{ border }}px 0 {{ alpha(c.outline_variant, g.border_alpha) }};
}

notebook > header > tabs > tab,
tabs tab {
  background-color: {{ alpha(c.surface, 0) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, 0) }};
  border-radius: {{ r.button }}px;
  color: {{ c.on_surface_variant }};
  margin: {{ sp.tab }}px;
  padding: {{ sp.tab_y }}px {{ sp.tab_x }}px;
  {{ transition(t.tab, m.fast, m.standard) }};
}

notebook > header > tabs > tab:hover,
tabs tab:hover {
  background-color: {{ alpha(c.surface_variant, g.tint_alpha) }};
  color: {{ c.on_surface }};
}

notebook > header > tabs > tab:checked,
tabs tab:checked {
  background-color: {{ alpha(c.accent, sh.tab_selected_alpha) }};
  border-color: {{ alpha(c.accent, g.border_alpha) }};
  color: {{ c.on_surface }};
}

notebook > header > tabs > tab:focus-visible,
tabs tab:focus-visible {
  {{ ring(border) }}
}

notebook > stack {
  background-color: {{ alpha(c.background, 0) }};
}

/* ---- lists, rows and cards --------------------------------------------- */

list,
listview {
  background-color: {{ alpha(c.surface, 0) }};
  border-color: {{ alpha(c.outline_variant, g.border_alpha) }};
  color: {{ c.on_surface }};
}

row,
listview > row {
  border-radius: {{ r.button }}px;
  padding: {{ sp.row_y }}px {{ sp.row_x }}px;
  {{ transition(t.press, m.fast, m.standard) }};
}

row:hover {
  background-color: {{ alpha(c.surface_variant, g.tint_alpha) }};
}

row:selected,
row:selected:hover {
  background-color: {{ alpha(c.accent, sh.tab_selected_alpha) }};
  color: {{ c.on_surface }};
}

row:disabled {
  color: {{ c.text_disabled }};
  opacity: {{ sh.disabled_opacity }};
}

row:focus-visible {
  {{ ring(border) }}
}

list > row.card,
.card {
  background-color: {{ alpha(c.surface, o.card) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.card }}px;
  box-shadow: {{ shadow(1, 3, sh.low_alpha) }};
}

list > row.card:selected {
  background-color: {{ alpha(c.accent, sh.tab_selected_alpha) }};
}

separator {
  background-color: {{ alpha(c.outline_variant, g.border_alpha) }};
  min-width: {{ border }}px;
  min-height: {{ border }}px;
}

/* ---- popovers, menus and drop-downs ------------------------------------ */

popover.background,
.menu,
popover.menu {
  background-color: {{ alpha(c.surface, o.popover) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.card }}px;
  box-shadow: {{ shadow(sh.y, sh.popover_blur, sh.popover_alpha) }};
  color: {{ c.on_surface }};
{% if blur_enabled %}  backdrop-filter: blur({{ blur_popover_px }}px);
{% endif %}}

popover > arrow {
  background-color: {{ alpha(c.surface, o.popover) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
}

menubar {
  background-color: {{ alpha(c.surface, o.headerbar) }};
  border-bottom: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  box-shadow: none;
}

menubar > item,
popover modelbutton,
popover.menu box > button {
  border-radius: {{ r.button }}px;
  color: {{ c.on_surface }};
  padding: {{ sp.menu_y }}px {{ sp.menu_x }}px;
  {{ transition(t.tab, m.fast, m.standard) }};
}

menubar > item:hover,
popover modelbutton:hover,
popover.menu box > button:hover {
  background-color: {{ alpha(c.surface_variant, g.tint_alpha_strong) }};
  color: {{ c.on_surface }};
}

menubar > item:selected,
popover modelbutton:active,
popover modelbutton:checked {
  background-color: {{ alpha(c.accent, sh.tab_selected_alpha) }};
}

menubar > item:disabled,
popover modelbutton:disabled {
  color: {{ c.text_disabled }};
  opacity: {{ sh.disabled_opacity }};
}

dropdown > button > box,
combobox > box > button {
  border-radius: {{ r.input }}px;
}

/* ---- tooltips, toasts, banners and dialogs ----------------------------- */

tooltip.background {
  background-color: {{ alpha(c.surface_variant, o.tooltip) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.button }}px;
  box-shadow: {{ shadow(1, 4, sh.low_alpha) }};
  color: {{ c.on_surface }};
  padding: {{ sp.tooltip_y }}px {{ sp.tooltip_x }}px;
{% if blur_enabled %}  backdrop-filter: blur({{ blur_popover_px }}px);
{% endif %}}

toast {
  background-color: {{ alpha(c.surface, o.toast) }};
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.pill_clamped }}px;
  box-shadow: {{ shadow(sh.y, sh.popover_blur, sh.popover_alpha) }};
  color: {{ c.on_surface }};
  margin: {{ sp.toast }}px;
  padding: {{ sp.toast_y }}px {{ sp.toast_x }}px;
{% if blur_enabled %}  backdrop-filter: blur({{ blur_popover_px }}px);
{% endif %}}

toast label {
  color: {{ c.on_surface }};
}

banner,
infobar,
.app-notification {
  background-color: {{ alpha(c.surface, o.toast) }};
  border: none;
  border-bottom: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: 0;
  box-shadow: none;
  color: {{ c.on_surface }};
}

infobar.error,
.app-notification.error {
  background-color: {{ alpha(c.danger, sh.banner_alpha) }};
}

infobar.warning,
.app-notification.warning {
  background-color: {{ alpha(c.warning, sh.banner_alpha) }};
}

infobar.question,
.app-notification.question {
  background-color: {{ alpha(c.accent, sh.banner_alpha) }};
}

dialog,
dialog.background,
window.dialog,
window.dialog.message {
  background-color: {{ alpha(c.background, o.dialog) }};
  border-radius: {{ r.window }}px;
  box-shadow: {{ shadow(sh.y, sh.dialog_blur, sh.dialog_alpha) }};
{% if blur_enabled %}  backdrop-filter: blur({{ blur_px }}px);
{% endif %}}

dialog > headerbar,
window.dialog .titlebar {
  background-color: {{ alpha(c.surface, o.dialog) }};
  border-radius: {{ r.window }}px {{ r.window }}px 0 0;
}

/* ---- text views, frames and the remaining surfaces --------------------- */

textview,
textview > text {
  background-color: {{ alpha(c.surface, o.card) }};
  caret-color: {{ c.accent }};
  color: {{ c.on_surface }};
}

treeview,
iconview,
columnview,
gridview,
flowbox {
  background-color: {{ alpha(c.surface, 0) }};
  color: {{ c.on_surface }};
}

treeview.view:selected,
iconview:selected,
flowbox > flowboxchild:selected,
gridview > child:selected {
  background-color: {{ alpha(c.accent, sh.tab_selected_alpha) }};
  color: {{ c.on_surface }};
}

frame,
.frame {
  border: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.card }}px;
}

frame > border {
  border: none;
  border-radius: {{ r.card }}px;
}

expander title,
expander-widget > box > title {
  border-radius: {{ r.button }}px;
  color: {{ c.on_surface }};
}

expander title:hover,
expander-widget > box > title:hover {
  background-color: {{ alpha(c.surface_variant, g.tint_alpha) }};
}

spinner {
  color: {{ c.accent }};
}

label.dim-label,
label.dimmed,
.dim-label {
  color: {{ c.on_surface_variant }};
  opacity: {{ sh.dim_opacity }};
}

link,
label link {
  color: {{ c.accent }};
}

link:visited {
  color: {{ c.secondary }};
}

image,
label {
  color: inherit;
}

actionbar > revealer > box {
  background-color: {{ alpha(c.surface, o.headerbar) }};
  border-top: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  box-shadow: none;
}

statusbar {
  background-color: {{ alpha(c.surface, o.headerbar) }};
  border-top: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
}

paned > separator {
  background-color: {{ alpha(c.outline_variant, g.border_alpha) }};
  min-width: {{ border }}px;
  min-height: {{ border }}px;
}

/* Respect a user who asks the desktop for less motion.

   A universal selector rather than a list of the controls this sheet happens to
   transition today, because an enumerated list silently misses whatever is added
   next. This one already had: spinbutton, .titlebar, listview > row and the three
   menu-item selectors each transition at {{ m.fast }}ms, and not one of them was named
   here, so a user who asked for less motion still got a fading menu.

   transition-delay goes with transition-duration: a delayed transition is motion
   the user still has to sit through. animation-duration deliberately does not.
   This sheet emits no keyframe animation at all, so every animation in a session
   comes from the application's own theme, and the common one is a spinner.
   Freezing a spinner does not reduce motion so much as hide the fact that
   something is still working.

   GTK 3 has no @media (its at-rule list stops at binding-set, define-color,
   import and keyframes), so a GTK 3 application gets reduce-motion from the
   iArch setting instead: docs/MOTION.md. */
@media (prefers-reduced-motion: reduce) {
  * {
    transition-duration: 0ms;
    transition-delay: 0ms;
  }
}
