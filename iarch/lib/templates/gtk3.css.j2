@define-color iarch_highlight {{ alpha('#ffffff', g.highlight_alpha) }};

/* ---- windows, header bars and the client-side decoration --------------- */

.background {
  color: {{ c.on_surface }};
}

window.background,
.background.csd {
  background-color: {{ alpha(c.background, o.window) }};
  {{ transition(t.fill, m.normal, m.standard) }};
}

window.background.solid-csd {
  background-color: {{ c.background }};
}

decoration {
  border-radius: {{ r.window }}px {{ r.window }}px 0 0;
  box-shadow: {{ shadow(sh.y, sh.blur, sh.alpha) }},
              0 0 0 {{ border }}px {{ alpha(c.outline_variant, g.border_alpha) }};
  margin: {{ sh.margin }}px;
}

decoration:backdrop {
  box-shadow: {{ shadow(sh.y, sh.blur, sh.backdrop_alpha) }},
              0 0 0 {{ border }}px {{ alpha(c.outline_variant, g.backdrop_border_alpha) }};
}

.maximized decoration,
.fullscreen decoration,
.tiled decoration {
  border-radius: 0;
  box-shadow: none;
  margin: 0;
}

headerbar,
.titlebar {
  background-color: {{ alpha(c.surface, o.headerbar) }};
  background-image: linear-gradient(to bottom,
                      {{ alpha('#ffffff', g.highlight_alpha) }},
                      {{ alpha('#ffffff', 0) }} {{ sh.headerbar_highlight_stop }}px);
  border-bottom: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  border-radius: {{ r.window }}px {{ r.window }}px 0 0;
  box-shadow: none;
  min-height: {{ sh.headerbar_min_height }}px;
  {{ transition(t.fill_border, m.normal, m.standard) }};
}

headerbar:backdrop,
.titlebar:backdrop {
  background-color: {{ alpha(c.surface, o.window) }};
  color: {{ c.text_disabled }};
}

headerbar .title {
  color: {{ c.on_surface }};
  font-weight: {{ sh.title_weight }};
}

headerbar .subtitle {
  color: {{ c.on_surface_variant }};
  font-size: {{ sh.subtitle_size }}px;
}

/* ---- sidebars: more opaque than the window they sit in ----------------- */

.sidebar,
placessidebar,
stacksidebar {
  background-color: {{ alpha(c.surface, o.sidebar) }};
  border-right: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
  color: {{ c.on_surface }};
}

.sidebar:dir(rtl),
placessidebar:dir(rtl) {
  border-right: none;
  border-left: {{ border }}px solid {{ alpha(c.outline_variant, g.border_alpha) }};
}

.sidebar:backdrop {
  background-color: {{ alpha(c.surface, o.window) }};
}

.sidebar row,
placessidebar row {
  border-radius: {{ r.button }}px;
  padding: {{ sp.row_y }}px {{ sp.row_x }}px;
}

.sidebar row:hover,
placessidebar row:hover {
  background-color: {{ alpha(c.surface_variant, g.tint_alpha) }};
}

.sidebar row:selected,
placessidebar row:selected {
  background-color: {{ alpha(c.accent, sh.tab_selected_alpha) }};
  color: {{ c.on_surface }};
}

