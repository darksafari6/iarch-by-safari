# iArch by Safari — product naming source of truth.
#
# Shell scripts read this file with:   . "$repo/branding/product.env"
# Python tools read the same file with: tools/iarch_brand.py
#
# Do not hardcode the product name anywhere else. Naming and credit policy:
# docs/BRANDING.md. Third-party credit lives in THIRD_PARTY_NOTICES.md and in
# the Settings page About -> Open-source licenses (both generated from
# branding/notices.json). Never rename a value that is also a runtime path or
# an upstream API identifier; those are marked "RUNTIME PATH" below.

# --- Identity -------------------------------------------------------------
IARCH_PRODUCT_NAME="iArch by Safari"
IARCH_PRODUCT_SHORT="iArch"
IARCH_PRODUCT_ID="iarch"
IARCH_PRODUCT_TAGLINE="Glass Hyprland desktop session for Arch Linux and Fedora"
IARCH_MAINTAINER="Safari"
IARCH_OWNER="darksafari6"
IARCH_REPO_SLUG="iarch-by-safari"
IARCH_REPO_URL="https://github.com/darksafari6/iarch-by-safari"

# --- Licensing ------------------------------------------------------------
IARCH_LICENSE_ID="GPL-3.0-only"
IARCH_LICENSE_FILE="LICENSE.txt"
IARCH_NOTICES_SOURCE="branding/notices.json"
IARCH_NOTICES_FILE="THIRD_PARTY_NOTICES.md"

# --- Theme / palette ------------------------------------------------------
# RUNTIME PATH: IARCH_PALETTE_ID is the stem of
# .config/noctalia/palettes/<id>.json and the value of [theme] custom_palette.
# IARCH_PALETTE_NAME is used only in this repository's documentation.
IARCH_PALETTE_ID="iarch-midnight"
IARCH_PALETTE_NAME="iArch Midnight"

# --- Effect profiles ------------------------------------------------------
# Base profile shipped in .config/noctalia/config.toml, plus overlays in
# profiles/. Every overlay may only change values of keys that already exist
# in the base profile; tools/profile_preset.py enforces that.
IARCH_PROFILE_DEFAULT="glass"
IARCH_PROFILE_PERFORMANCE="performance"
IARCH_PROFILE_DIR="profiles"

# --- Runtime paths owned by upstream projects (never rebrand these) -------
# RUNTIME PATH: configuration directory of the shell binary.
IARCH_SHELL_CONFIG_DIR="noctalia"
# RUNTIME PATH: Hyprland configuration entry point of the current session.
IARCH_HYPRLAND_ENTRY="hypr/hyprland.lua"
# RUNTIME PATH: isolated configuration root of the frozen legacy v4 session.
IARCH_LEGACY_V4_CONFIG_DIR="minimalinux"
