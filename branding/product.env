# iArch by Safari — product naming source of truth.
#
# Shell scripts read this file with:   . "$repo/branding/product.env"
# Python tools read the same file with: tools/iarch_brand.py
#
# Do not hardcode the product name anywhere else. Naming and credit policy:
# docs/BRANDING.md. Third-party credit lives in THIRD_PARTY_NOTICES.md and in
# the Settings page About -> Open-source licenses (both generated from
# branding/notices.json). Never rename a value that is also a runtime path or
# an upstream API identifier; those are marked "RUNTIME PATH" below.

# --- Identity -------------------------------------------------------------
IARCH_PRODUCT_NAME="iArch by Safari"
IARCH_PRODUCT_SHORT="iArch"
IARCH_PRODUCT_ID="iarch"
IARCH_PRODUCT_TAGLINE="Glass Hyprland desktop session for Arch Linux and Fedora"
IARCH_MAINTAINER="Safari"
IARCH_OWNER="darksafari6"
IARCH_REPO_SLUG="iarch-by-safari"
IARCH_REPO_URL="https://github.com/darksafari6/iarch-by-safari"

# --- Licensing ------------------------------------------------------------
# SPDX expression. LICENSE.txt carries the GNU GPL version 3 text; the header
# below exercises its "or any later version" option, so the two agree.
IARCH_LICENSE_ID="GPL-3.0-or-later"
# The exact line every new file in this repository starts with (after its
# shebang). tools/notices.py stamps it into data/licenses.json and
# tests/test_copyright_headers.py checks it.
IARCH_COPYRIGHT_HEADER="Copyright (C) 2026 Safari — GPL-3.0-or-later"
IARCH_LICENSE_FILE="LICENSE.txt"
IARCH_NOTICES_SOURCE="branding/notices.json"
IARCH_NOTICES_FILE="THIRD_PARTY_NOTICES.md"
# RUNTIME DATA: machine-readable credit data rendered from the same source, read
# by the settings app for About -> Open-source licenses.
IARCH_LICENSES_FILE="data/licenses.json"

# --- Theme / palette ------------------------------------------------------
# RUNTIME PATH: IARCH_PALETTE_ID is the stem of
# .config/noctalia/palettes/<id>.json and the value of [theme] custom_palette.
# IARCH_PALETTE_NAME is used only in this repository's documentation.
IARCH_PALETTE_ID="iarch-midnight"
IARCH_PALETTE_NAME="iArch Midnight"

# --- Effect profiles ------------------------------------------------------
# Base profile shipped in .config/noctalia/config.toml, plus overlays in
# profiles/. Every overlay may only change values of keys that already exist
# in the base profile; tools/profile_preset.py enforces that.
IARCH_PROFILE_DEFAULT="glass"
IARCH_PROFILE_PERFORMANCE="performance"
IARCH_PROFILE_DIR="profiles"

# --- Identifier conventions for components authored by this project -------
# New binaries, services and desktop files use the `iarch` prefix. These are
# conventions for work scheduled in docs/ROADMAP.md; nothing here renames an
# existing file, and a value only becomes a path once that component ships.
#   iarch-settings   the glass settings application (Part 2)
#   iarch-theme      appearance and palette tooling
#   iarch-keybinds   shortcut management and the Super+H overlay (Part 7)
#   iarch-doctor     diagnostics, successor of scripts/iarch-healthcheck.sh
IARCH_COMPONENT_SETTINGS="iarch-settings"
IARCH_COMPONENT_THEME="iarch-theme"
IARCH_COMPONENT_KEYBINDS="iarch-keybinds"
IARCH_COMPONENT_DOCTOR="iarch-doctor"
# RUNTIME PATH (future): user-owned configuration of the components above
# lives in ~/.config/iarch/, never inside another program's directory.
IARCH_USER_CONFIG_DIR="iarch"
# Reverse-DNS desktop application ids used by Wayland/GTK integration.
# RUNTIME PATH: a compositor matches a GTK 4 application's Wayland app_id as its
# window class, so these two strings are what the glass window rules in
# data/design/tokens.json (app_classes.iarch_app) match on. Both are anchored
# there, which is why the settings application needs its own id rather than
# sharing the session's: ^dev\.safari\.iarch$ does not match
# dev.safari.iarch.settings, and a window no rule matches is a window with no
# opacity and no blur.
IARCH_APP_ID="dev.safari.iarch"
IARCH_APP_ID_SETTINGS="dev.safari.iarch.settings"

# --- Runtime paths owned by upstream projects (never rebrand these) -------
# RUNTIME PATH: configuration directory of the shell binary.
IARCH_SHELL_CONFIG_DIR="noctalia"
# RUNTIME PATH: Hyprland configuration entry point of the current session.
IARCH_HYPRLAND_ENTRY="hypr/hyprland.lua"
# RUNTIME PATH: isolated configuration root of the frozen legacy v4 session.
IARCH_LEGACY_V4_CONFIG_DIR="minimalinux"
