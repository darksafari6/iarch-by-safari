{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "_note": "The Kvantum theme keys this project writes, with the type, integer bound and enum upstream declares for each. Derived from the sources named below at the tag in verified_against, by reading every getValue(KSL(\"Group\"),KSL(\"key\")) call in ThemeConfig.cpp (the exhaustive vocabulary the style engine actually reads) and the type and range column of doc/Theme-Config. render_kvantum.py refuses to emit a key that is not listed here, an integer outside its bound, or an enum value outside its set.",
  "verified_against": "V1.1.9",
  "source": "Kvantum/style/themeconfig/ThemeConfig.cpp (the getValue call sites: 89 [%General] keys, 28 [GeneralColors] keys, 23 [Hacks] keys), Kvantum/doc/Theme-Config (types, integer bounds, enum meanings), Kvantum/style/themeconfig/default.kvconfig (the shipped default theme), Kvantum/style/kvantum.json (the Qt style names are \"kvantum\" and \"kvantum-dark\"), Kvantum/style/themeconfig/defaulttheme.qrc (a compiled-in default SVG, so an INI-only theme still resolves element art)",
  "diagnostics": {
    "unknown_key": "QSettings reads the file as generic INI: a key ThemeConfig.cpp never asks for is parsed and then ignored, with no warning. A misspelled key silently does nothing.",
    "out_of_range": "ThemeConfig.cpp clamps most integers to their documented bound and continues, so an out-of-range number is silently changed rather than rejected.",
    "consequence": "Neither a silent ignore nor a silent clamp is acceptable in a shipped payload, so this project treats both as render-time failures."
  },
  "activation": {
    "style_names": [
      "kvantum",
      "kvantum-dark"
    ],
    "mechanism": "Kvantum is a Qt style, chosen in qt6ct (or Kvantum Manager), which writes the style into ~/.config/qt6ct/qt6ct.conf. It is NOT chosen with QT_STYLE_OVERRIDE: qt6ct explicitly asks the user to remove that variable if it is set.",
    "pointer_file": "~/.config/Kvantum/kvantum.kvconfig",
    "pointer_key": "theme",
    "theme_dir": "~/.config/Kvantum/<theme>/",
    "theme_file": "<theme>.kvconfig"
  },
  "compositor": {
    "blurring": "Kvantum blurring and popup_blurring need the KDE blur effect and a supporting GPU; they have no effect when composite or translucent_windows is false. Under Hyprland there is no KDE blur, so both are written false and the frosted look comes from a translucent interior plus the compositor blur in .config/hypr/generated/glass.lua.",
    "shadowless_popup": "Hyprland already shadows popup windows through decoration:shadow in glass.lua, so shadowless_popup is true and menu/tooltip shadow depths are 0: a second Kvantum shadow would double the one the compositor draws.",
    "translucency_without_svg": "This project ships an INI-only theme (no custom SVG; the compiled-in default SVG resolves element art). The doc states window translucency needs either a translucent SVG element or a nonzero reduce_window_opacity, so translucency is driven entirely by reduce_window_opacity / reduce_menu_opacity, derived from the intensity.",
    "menu_blur_radius": "menu_blur_radius / tooltip_blur_radius are NOT screen blur: they are the corner radius used when blurring the corners of a rounded translucent popup to avoid artifacts. The doc recommends 2, which is what is written."
  },
