{
  "_copyright": "Copyright (C) 2026 Safari \u2014 GPL-3.0-or-later",
  "version": 1,
  "id": "crimson-silk",
  "name": "Crimson Silk",
  "mode": "dark",
  "description": "Dark red surfaces with a coral accent and a yellow secondary for folder-like highlights. Notifications, the bar and the terminal follow the coral.",
  "default_intensity": "frosted",
  "palette": {
    "background": "#140608",
    "surface": "#2a1014",
    "surface_variant": "#36161c",
    "on_background": "#f8e8e4",
    "on_surface": "#f8e8e4",
    "on_surface_variant": "#e0c0b8",
    "outline": "#92625a",
    "outline_variant": "#4a2024",
    "shadow": "#080304",
    "text_disabled": "#c49890",
    "accent": {
      "primary": "#e07060",
      "secondary": "#f0b429",
      "success": "#8fd18a",
      "warning": "#f0b429",
      "danger": "#ff6b6b"
    },
    "on_accent": {
      "primary": "#2b0c08",
      "secondary": "#2b1c00",
      "success": "#04231a",
      "warning": "#2b1c00",
      "danger": "#2b0710"
    }
  },
  "terminal": {
    "colors": {
      "background": "#140608",
      "foreground": "#f8e8e4",
      "cursor": "#e07060",
      "cursor_text": "#2b0c08",
      "selection_background": "#4a2024",
      "selection_foreground": "#fff4f0",
      "url_color": "#f0b429",
      "color0": "#2c1416",
      "color1": "#ff6b6b",
      "color2": "#8fd18a",
      "color3": "#f0b429",
      "color4": "#e09080",
      "color5": "#f0a0a8",
      "color6": "#d0a090",
      "color7": "#ecd8d4",
      "color8": "#5a3034",
      "color9": "#ff9a94",
      "color10": "#b4e4aa",
      "color11": "#f8d060",
      "color12": "#f0b8b0",
      "color13": "#f8c0c4",
      "color14": "#e8c8b8",
      "color15": "#fff6f2"
    },
    "background_opacity_from_tokens": true,
    "padding_px": 14,
    "tab_bar_style": "powerline",
    "tab_bar_separator": "  \u2502  "
  },
  "gtk": {
    "accent": "#e07060",
    "theme_dark": "adw-gtk3-dark",
    "theme_light": "adw-gtk3",
    "sidebar_alpha_delta": 0.06
  },
  "cursor": {
    "theme": "Bibata-Modern-Classic",
    "size": 24
  },
  "icons": {
    "theme": "Papirus-Dark",
    "available": [
      {
        "id": "papirus-dark",
        "name": "Papirus (dark)",
        "theme": "Papirus-Dark",
        "license": "GPL-3.0",
        "upstream": "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme",
        "package_arch": "papirus-icon-theme",
        "package_fedora": "papirus-icon-theme",
        "verified": true,
        "note": "Arch's extra repository carries papirus-icon-theme: version 20260801-1, GPL-3.0, read from the package search JSON API on 2026-11-09. The 'Icons and cursors' step of install.sh fetches it with yay, so a mirror that lacks it costs an icon theme rather than the whole install. The Fedora package name is still unverified (docs/UNVERIFIED.md TP-13)."
      },
      {
        "id": "papirus-light",
        "name": "Papirus (light)",
        "theme": "Papirus-Light",
        "license": "GPL-3.0",
        "upstream": "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme",
        "package_arch": "papirus-icon-theme",
        "package_fedora": "papirus-icon-theme",
        "verified": true,
        "note": "The same Arch package provides Papirus-Light, verified the same way on 2026-11-09. The Fedora package name is still unverified (TP-13)."
      },
      {
        "id": "yaru",
        "name": "Yaru",
        "theme": "Yaru",
        "license": "GPL-3.0 and CC-BY-SA-4.0 icons",
        "upstream": "https://github.com/ubuntu/yaru",
        "package_arch": "yaru-icon-theme",
        "package_fedora": "yaru-icon-theme",
        "verified": false,
        "note": "Fetched by the 'Icons and cursors' step of install.sh, which warns rather than stopping the install: neither the Arch nor the Fedora name is verified from this environment (TP-13). Licence split between the code and the artwork, see THIRD_PARTY_NOTICES.md."
      }
    ]
  },
  "wallpaper": {
    "kind": "bundled",
    "path": "assets/wallpapers/desktop-red.webp",
    "credit": "Reuses a wallpaper this repository already generated. No third-party artwork."
  },
  "noctalia": {
    "counterpart": {
      "preset": "frosted-light",
      "mode": "light"
    },
    "palette_id": "iarch-crimson-silk",
    "palette_name": "iArch Crimson Silk"
  }
}
