{
  "_copyright": "Copyright (C) 2026 Safari \u2014 GPL-3.0-or-later",
  "version": 1,
  "id": "forest-night",
  "name": "Forest Night",
  "mode": "dark",
  "description": "Near-black with a green accent. The default session theme when the user has not chosen one. Flat surfaces, same green on the bar, toasts and the prompt colors.",
  "default_intensity": "soft",
  "palette": {
    "background": "#0c0e0c",
    "surface": "#161916",
    "surface_variant": "#1c221c",
    "on_background": "#e7f0e4",
    "on_surface": "#e7f0e4",
    "on_surface_variant": "#c5d4c0",
    "outline": "#5c7456",
    "outline_variant": "#243024",
    "shadow": "#060806",
    "text_disabled": "#8aa484",
    "accent": {
      "primary": "#8fcb6a",
      "secondary": "#c6e6a0",
      "success": "#9ee08a",
      "warning": "#e6d48a",
      "danger": "#e08a7a"
    },
    "on_accent": {
      "primary": "#10200c",
      "secondary": "#1a2810",
      "success": "#04231a",
      "warning": "#2b1c00",
      "danger": "#2b0710"
    }
  },
  "terminal": {
    "colors": {
      "background": "#0c0e0c",
      "foreground": "#e7f0e4",
      "cursor": "#8fcb6a",
      "cursor_text": "#10200c",
      "selection_background": "#243024",
      "selection_foreground": "#f2f8f0",
      "url_color": "#c6e6a0",
      "color0": "#1a201a",
      "color1": "#e08a7a",
      "color2": "#8fcb6a",
      "color3": "#e6d48a",
      "color4": "#8fb88a",
      "color5": "#c0d0a8",
      "color6": "#88c0b0",
      "color7": "#d0dcc8",
      "color8": "#3a4838",
      "color9": "#f0b0a4",
      "color10": "#b0e89a",
      "color11": "#f0e4a8",
      "color12": "#b0d8aa",
      "color13": "#d8e8c0",
      "color14": "#b0dcd0",
      "color15": "#f4faf2"
    },
    "background_opacity_from_tokens": true,
    "padding_px": 14,
    "tab_bar_style": "powerline",
    "tab_bar_separator": "  \u2502  "
  },
  "gtk": {
    "accent": "#8fcb6a",
    "theme_dark": "adw-gtk3-dark",
    "theme_light": "adw-gtk3",
    "sidebar_alpha_delta": 0.06
  },
  "cursor": {
    "theme": "Bibata-Modern-Classic",
    "size": 24
  },
  "icons": {
    "theme": "Papirus-Dark",
    "available": [
      {
        "id": "papirus-dark",
        "name": "Papirus (dark)",
        "theme": "Papirus-Dark",
        "license": "GPL-3.0",
        "upstream": "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme",
        "package_arch": "papirus-icon-theme",
        "package_fedora": "papirus-icon-theme",
        "verified": true,
        "note": "Arch's extra repository carries papirus-icon-theme: version 20260801-1, GPL-3.0, read from the package search JSON API on 2026-11-09. The 'Icons and cursors' step of install.sh fetches it with yay, so a mirror that lacks it costs an icon theme rather than the whole install. The Fedora package name is still unverified (docs/UNVERIFIED.md TP-13)."
      },
      {
        "id": "papirus-light",
        "name": "Papirus (light)",
        "theme": "Papirus-Light",
        "license": "GPL-3.0",
        "upstream": "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme",
        "package_arch": "papirus-icon-theme",
        "package_fedora": "papirus-icon-theme",
        "verified": true,
        "note": "The same Arch package provides Papirus-Light, verified the same way on 2026-11-09. The Fedora package name is still unverified (TP-13)."
      },
      {
        "id": "yaru",
        "name": "Yaru",
        "theme": "Yaru",
        "license": "GPL-3.0 and CC-BY-SA-4.0 icons",
        "upstream": "https://github.com/ubuntu/yaru",
        "package_arch": "yaru-icon-theme",
        "package_fedora": "yaru-icon-theme",
        "verified": false,
        "note": "Fetched by the 'Icons and cursors' step of install.sh, which warns rather than stopping the install: neither the Arch nor the Fedora name is verified from this environment (TP-13). Licence split between the code and the artwork, see THIRD_PARTY_NOTICES.md."
      }
    ]
  },
  "wallpaper": {
    "kind": "bundled",
    "path": "assets/wallpapers/desktop/obsidian-mesh.webp",
    "credit": "Reuses a wallpaper this repository already generated. No third-party artwork."
  },
  "noctalia": {
    "counterpart": {
      "preset": "frosted-light",
      "mode": "light"
    },
    "palette_id": "iarch-forest-night",
    "palette_name": "iArch Forest Night"
  }
}
