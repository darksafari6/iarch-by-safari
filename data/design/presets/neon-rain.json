{
  "_copyright": "Copyright (C) 2026 Safari \u2014 GPL-3.0-or-later",
  "version": 1,
  "id": "neon-rain",
  "name": "Neon Rain",
  "mode": "dark",
  "description": "Magenta and violet on a night base. Notification cards, workspace pills and the terminal use the same primary.",
  "default_intensity": "crystal",
  "palette": {
    "background": "#120816",
    "surface": "#1c1024",
    "surface_variant": "#261432",
    "on_background": "#f4e9ff",
    "on_surface": "#f4e9ff",
    "on_surface_variant": "#d2bee8",
    "outline": "#7e5e9e",
    "outline_variant": "#3a2048",
    "shadow": "#07040c",
    "text_disabled": "#b090c8",
    "accent": {
      "primary": "#d090ff",
      "secondary": "#ff8ac4",
      "success": "#7ee0b0",
      "warning": "#ffd27a",
      "danger": "#ff6b9a"
    },
    "on_accent": {
      "primary": "#24083a",
      "secondary": "#3a0820",
      "success": "#04231a",
      "warning": "#2b1c00",
      "danger": "#2b0710"
    }
  },
  "terminal": {
    "colors": {
      "background": "#120816",
      "foreground": "#f4e9ff",
      "cursor": "#d090ff",
      "cursor_text": "#24083a",
      "selection_background": "#3a204c",
      "selection_foreground": "#f8f0ff",
      "url_color": "#ff8ac4",
      "color0": "#241430",
      "color1": "#ff6b9a",
      "color2": "#7ee0b0",
      "color3": "#ffd27a",
      "color4": "#b090ff",
      "color5": "#ff8ac4",
      "color6": "#80d0e8",
      "color7": "#e0d0f0",
      "color8": "#4a3060",
      "color9": "#ff9ab8",
      "color10": "#a8f0c8",
      "color11": "#ffe0a0",
      "color12": "#d0b8ff",
      "color13": "#ffb0d8",
      "color14": "#a8e4f4",
      "color15": "#f8f0ff"
    },
    "background_opacity_from_tokens": true,
    "padding_px": 14,
    "tab_bar_style": "powerline",
    "tab_bar_separator": "  \u2502  "
  },
  "gtk": {
    "accent": "#d090ff",
    "theme_dark": "adw-gtk3-dark",
    "theme_light": "adw-gtk3",
    "sidebar_alpha_delta": 0.06
  },
  "cursor": {
    "theme": "Bibata-Modern-Classic",
    "size": 24
  },
  "icons": {
    "theme": "Papirus-Dark",
    "available": [
      {
        "id": "papirus-dark",
        "name": "Papirus (dark)",
        "theme": "Papirus-Dark",
        "license": "GPL-3.0",
        "upstream": "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme",
        "package_arch": "papirus-icon-theme",
        "package_fedora": "papirus-icon-theme",
        "verified": true,
        "note": "Arch's extra repository carries papirus-icon-theme: version 20260801-1, GPL-3.0, read from the package search JSON API on 2026-11-09. The 'Icons and cursors' step of install.sh fetches it with yay, so a mirror that lacks it costs an icon theme rather than the whole install. The Fedora package name is still unverified (docs/UNVERIFIED.md TP-13)."
      },
      {
        "id": "papirus-light",
        "name": "Papirus (light)",
        "theme": "Papirus-Light",
        "license": "GPL-3.0",
        "upstream": "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme",
        "package_arch": "papirus-icon-theme",
        "package_fedora": "papirus-icon-theme",
        "verified": true,
        "note": "The same Arch package provides Papirus-Light, verified the same way on 2026-11-09. The Fedora package name is still unverified (TP-13)."
      },
      {
        "id": "yaru",
        "name": "Yaru",
        "theme": "Yaru",
        "license": "GPL-3.0 and CC-BY-SA-4.0 icons",
        "upstream": "https://github.com/ubuntu/yaru",
        "package_arch": "yaru-icon-theme",
        "package_fedora": "yaru-icon-theme",
        "verified": false,
        "note": "Fetched by the 'Icons and cursors' step of install.sh, which warns rather than stopping the install: neither the Arch nor the Fedora name is verified from this environment (TP-13). Licence split between the code and the artwork, see THIRD_PARTY_NOTICES.md."
      }
    ]
  },
  "wallpaper": {
    "kind": "bundled",
    "path": "assets/wallpapers/desktop/midnight-aurora.webp",
    "credit": "Reuses a wallpaper this repository already generated. No third-party artwork."
  },
  "noctalia": {
    "counterpart": {
      "preset": "frosted-light",
      "mode": "light"
    },
    "palette_id": "iarch-neon-rain",
    "palette_name": "iArch Neon Rain"
  }
}
