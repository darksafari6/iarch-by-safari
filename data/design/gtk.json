{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "_note": "The GTK CSS surface iarch/cli/render_gtk_css.py is allowed to emit, extracted from the upstream parsers and the upstream themes. GTK warns about an unknown property but keeps loading, and libadwaita overrides user CSS for many widgets, so a mistake here ships as a theme that silently half-applies. Anything not listed is refused.",
  "verified_against": {
    "gtk4": "4.24.1",
    "gtk3": "3.24.52",
    "libadwaita": "1.10.0",
    "adw_gtk3": "v6.5"
  },
  "source": {
    "gtk4_properties": "GNOME/gtk 4.24.1 gtk/gtkcssstylepropertyimpl.c",
    "gtk4_shorthands": "GNOME/gtk 4.24.1 gtk/gtkcssshorthandpropertyimpl.c",
    "gtk3_properties": "GNOME/gtk 3.24.52 gtk/gtkcssstylepropertyimpl.c",
    "gtk3_shorthands": "GNOME/gtk 3.24.52 gtk/gtkcssshorthandpropertyimpl.c",
    "pseudo_classes": "GNOME/gtk gtk/gtkcssselector.c at each version",
    "color_functions": "GNOME/gtk gtk/gtkcsscolorvalue.c at each version",
    "filter_functions": "GNOME/gtk 4.24.1 gtk/gtkcssfiltervalue.c; the file does not exist at 3.24.52",
    "gtk4_node_names": "GNOME/gtk 4.24.1 gtk/theme/Default/_common.scss plus GNOME/libadwaita 1.10.0 src/stylesheet/",
    "gtk3_node_names": "GNOME/gtk 3.24.52 gtk/theme/Adwaita/_common.scss",
    "libadwaita_node_names": "GNOME/libadwaita 1.10.0 src/adw-*.c and src/stylesheet/",
    "gtk4_style_classes": "GNOME/gtk 4.24.1 gtk/theme/Default/_common.scss plus GNOME/libadwaita 1.10.0 src/stylesheet/",
    "libadwaita_style_classes": "GNOME/libadwaita 1.10.0 src/stylesheet/widgets/{_buttons,_lists,_sidebars,_header-bar,_popovers,_tooltip,_switch,_entries,_scale,_scrolling,_dialogs,_tab-view,_menus,_window}.scss; this is a sample of the 45 widget stylesheets, so a class absent here was not used rather than assumed invalid",
    "gtk3_style_classes": "GNOME/gtk 3.24.52 gtk/theme/Adwaita/_common.scss plus every GTK_STYLE_CLASS_* in gtk/gtkstylecontext.h at that version",
    "at_rules": "gtk_css_parser_try_at_keyword / the @-token scan of gtk/gtkcssprovider.c at each version",
    "transform_functions": "GNOME/gtk 4.24.1 gtk/gtkcsstransformvalue.c; GTK 3 has no transform property, so it has no transform functions"
  },
  "diagnostics": {
    "unknown_property": "GTK logs \"Unhandled property\" / a parse warning and continues; the declaration is dropped, so the widget keeps the theme default",
    "unknown_node_name": "a selector that matches nothing is silently kept, so the rule never applies",
    "consequence": "neither failure is visible to the user, which is why the renderer refuses to write a stylesheet that uses anything not recorded here",
    "unknown_style_class": "a class no widget carries makes the selector match nothing; the rule is kept and never applies, so the widget keeps the theme default and the sheet looks applied while doing nothing",
    "important": "the word important does not appear in either provider: GTK CSS has no !important, so an overlay cannot force its way past the theme. ~/.config/gtk-4.0/gtk.css and ~/.config/gtk-3.0/gtk.css are parsed after the theme, which means a rule of equal specificity wins on order, and a rule that has to beat libadwaita must match or exceed its specificity",
    "gtk4_style_classes": "GTK 4 removed gtk/gtkstylecontext.h, so there is no exhaustive list of style classes to check against. The classes recorded here are the ones the GTK 4 default theme and 14 of libadwaita's 45 widget stylesheets actually style, which proves each exists but does not prove the set is complete; a class missing from it was not used rather than assumed invalid",
    "gtk3_dir": "GTK 3 registers the direction pseudo-class with its argument as a single token, \"dir(ltr)\" and \"dir(rtl)\", so :dir() is valid there even though no bare \"dir\" string appears in gtkcssselector.c; the GTK 3 Adwaita theme uses it 60 times"
  },
