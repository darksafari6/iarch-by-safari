    "commit": "5b41ded2b0ddb98a07ac86264b94403cb7a0fd82"
  },
  "source": "fonts.dtd (the configuration DTD: every element, its content model and its attribute enumerations), src/fcxml.c (the parser that reads a config against that DTD)",
  "stability": "The configuration DTD is a long-stable interface: every element and attribute this project emits has been in fontconfig since well before the pinned 2.13.1 and is unchanged in current releases. The mirror carries no release tags, so the surface pins the mirror commit rather than a tag.",
  "diagnostics": {
    "unknown_element": "fcxml.c reports \"unknown element\" to stderr and skips it; the rest of the file still loads, so a typo silently drops one rule.",
    "unknown_attribute": "an attribute the DTD does not declare for an element is ignored, again with only a stderr warning.",
    "uninstalled_family": "a family name that matches no installed font is simply never selected; fontconfig falls through to the next preference, so a misspelled family degrades to a system default with no error.",
    "consequence": "A dropped rule and a silent fall-through are both acceptable to fontconfig but not in a shipped payload, so this project treats both as render-time failures."
  },
