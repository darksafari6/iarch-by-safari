{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "_note": "The Noctalia settings this project writes, with the type, range and enum upstream declares for each. Derived from the sources named below at the tag in verified_against, by reading the Schema<> declarations in config_schema.cpp (field/enumField/colorField/subTable/custom and their optional* variants), the Range<> constants in ranges.h and config_schema.cpp, and the enum tables in config_types.h. render_noctalia.py refuses to emit a key that is not listed here.",
  "verified_against": "v5.4.1",
  "source": "src/config/schema/config_schema.cpp, src/config/schema/ranges.h, src/config/config_types.h, src/config/config_validate.cpp, src/theme/custom_palettes.cpp, docs/user/theming/palette.mdx",
  "diagnostics": {
    "unknown_key": "warning: config_validate.cpp reports diag.warn(path, \"unknown setting\") and the parser ignores the key",
    "out_of_range": "warning: the parser clamps and continues, so a bad number is silently changed",
    "bad_type_or_color": "error",
    "consequence": "Neither a warning nor a clamp is acceptable in a shipped payload: this project treats both as failures at render time."
  },
  "bar_container": {
    "_note": "Bars live at the config root, not in a section: {\"bar\"} and {\"bar\",name} are container levels, and \"position\" and \"name\" are keyed outside barFieldsSchema (isKnownConfigPath in config_schema.cpp).",
    "order_key": "order",
    "keyed_outside_fields": [
      "position",
      "name"
    ],
    "monitor_override_schema": "barMonitorOverrideSchema"
  },
  "color_roles": [
    "primary",
    "on_primary",
    "primary_container",
    "on_primary_container",
    "secondary",
    "on_secondary",
    "secondary_container",
    "on_secondary_container",
    "tertiary",
    "on_tertiary",
    "tertiary_container",
    "on_tertiary_container",
    "error",
    "on_error",
    "error_container",
    "on_error_container",
    "surface",
    "on_surface",
    "on_surface_variant",
    "surface_container_low",
    "surface_container",
    "surface_container_high",
    "surface_container_highest",
    "outline_variant",
    "shadow",
    "scrim",
    "hover",
    "on_hover"
  ],
  "color_roles_note": "The 28 user-facing roles from docs/user/theming/palette.mdx. A colorField accepts one of these names or a fixed hex colour (#RGB, #RGBA, #RRGGBB, #RRGGBBAA); role names are preferred so colours follow the palette. surface_variant and outline were renamed to surface_container and outline_variant, and Noctalia rewrites the old names on load with a warning.",
  "palette": {
    "_note": "Contract from docs/user/theming/palette.mdx and src/theme/custom_palettes.cpp.",
    "directory": "palettes/",
    "selected_by": "theme.custom_palette",
    "modes": [
      "dark",
      "light"
    ],
    "light_optional": "If light is omitted, Noctalia uses the dark variant for both modes.",
    "fields": [
      "mPrimary",
      "mOnPrimary",
      "mSecondary",
      "mOnSecondary",
      "mTertiary",
      "mOnTertiary",
      "mError",
      "mOnError",
      "mSurface",
      "mOnSurface",
      "mSurfaceVariant",
      "mOnSurfaceVariant",
      "mOutline",
      "mShadow",
      "mHover",
      "mOnHover"
    ],
    "field_forms": "writeFixedColor emits \"m\" + UpperCamel; the reader tries the prefixed key first and falls back to the unprefixed camelCase name.",
    "terminal_optional": true,
    "terminal_fields": [
      "background",
      "foreground",
      "cursor",
      "cursorText",
      "selectionBg",
      "selectionFg"
    ],
    "terminal_ansi": [
      "black",
      "red",
      "green",
      "yellow",
      "blue",
      "magenta",
      "cyan",
      "white"
    ],
    "terminal_groups": [
      "normal",
      "bright"
    ],
    "name_sanitization": "sanitizePaletteNameComponent keeps alphanumerics and folds separators to single dashes, lowercased."
  },
