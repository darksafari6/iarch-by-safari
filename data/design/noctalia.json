          "enum_constant": "kThemeModes"
        },
        "shell_mode": {
          "type": "string",
          "enum": [
            "follow",
            "dark",
            "light",
            "auto"
          ],
          "enum_constant": "kShellThemeModes"
        },
        "source": {
          "type": "string",
          "enum": [
            "builtin",
            "wallpaper",
            "community",
            "custom"
          ],
          "enum_constant": "kPaletteSources"
        },
        "custom_palette": {
          "type": "string"
        },
        "sync_color_scheme": {
          "type": "bool"
        },
        "pure_black_dark": {
          "type": "bool"
        }
