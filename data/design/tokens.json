{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "version": 1,
  "name": "iarch-glass",
  "description": "The iArch by Safari glass design system. Every generator in iarch/cli reads this file instead of hard-coding a number, so one edit here changes the compositor, the shell, GTK, Qt, the terminal and the font stack together. Presets in data/design/presets/ override the colour roles only; the geometry, blur and motion values live here.",
  "docs": "docs/DESIGN-SYSTEM.md",

  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "pill": 999,
    "power": 2.0,
    "window": "md",
    "panel": "lg",
    "card": "md",
    "button": "sm",
    "input": "sm",
    "tooltip": "xs"
  },

  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },

  "motion": {
    "fast_ms": 120,
    "normal_ms": 220,
    "slow_ms": 380,
    "easing": {
      "standard": { "type": "bezier", "points": [[0.4, 0.0], [0.2, 1.0]] },
      "emphasized": { "type": "bezier", "points": [[0.2, 0.0], [0.0, 1.0]] },
      "decelerate": { "type": "bezier", "points": [[0.0, 0.0], [0.2, 1.0]] },
      "accelerate": { "type": "bezier", "points": [[0.4, 0.0], [1.0, 1.0]] }
    },
    "spring": { "stiffness": 220.0, "damping": 26.0, "mass": 1.0 },
    "_note": "Consumed by Part 3 (animations). Curve shapes are the ones hl.curve() accepts: { type = \"bezier\", points = {{x1,y1},{x2,y2}} } or { type = \"spring\", stiffness, damping, mass }, each of the three spring numbers >= 0.5 (verified in src/config/lua/bindings/LuaBindingsConfigRules.cpp). Transitions in CSS only animate background-color, border-color, box-shadow, color and opacity."
  },

  "font": {
    "ui": "Inter",
    "ui_display": "Inter Display",
    "mono": "JetBrainsMono Nerd Font",
    "emoji": "Noto Color Emoji",
    "sizes": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "xxl": 28
    },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "line_height": 1.45,
    "fallback": [
      { "family": "Noto Sans", "script": "generic sans fallback" },
      { "family": "Noto Sans CJK SC", "script": "Han, Hiragana, Katakana, Hangul" },
      { "family": "Noto Naskh Arabic", "script": "Arabic" },
      { "family": "Noto Nastaliq Urdu", "script": "Urdu (Nastaliq)" },
      { "family": "Noto Color Emoji", "script": "emoji" },
      { "family": "DejaVu Sans", "script": "last-resort coverage" }
    ],
    "_note": "Family names are the upstream family names, not package names; iarch/cli/gen_fontconfig.py maps them onto whatever the distribution actually installed. Symbola is deliberately absent: its licence could not be verified (docs/UNVERIFIED.md TP-12)."
  },

  "accent": {
    "primary": "#8b95ff",
    "secondary": "#5eead4",
    "success": "#4ade80",
    "warning": "#fbbf24",
    "danger": "#f87171"
  },

  "default_intensity": "frosted",

  "intensities": {
    "crystal": {
      "label": "Crystal",
      "description": "Strongest glass: heavy blur behind a barely-there tint. The most expensive setting; pick it on a discrete GPU.",
      "blur": {
        "enabled": true,
        "variant": "acrylic",
        "size": 12,
        "passes": 4,
        "noise": 0.015,
        "contrast": 0.95,
        "brightness": 1.05,
        "vibrancy": 0.28,
        "xray": false,
        "ignore_opacity": true,
        "new_optimizations": true,
        "popups": true,
        "special": false
      },
      "glass": {
        "tint_alpha": 0.22,
        "tint_alpha_strong": 0.34,
        "border_alpha": 0.22,
        "highlight_alpha": 0.14,
        "shadow_alpha": 0.44
      },
      "shadow": {
        "enabled": true,
        "range": 32,
        "render_power": 2,
        "color": "#000000",
        "color_inactive": "#000000",
        "offset": [0, 8],
        "scale": 1.0,
        "sharp": false
      },
      "window": {
        "active_opacity": 1.0,
        "inactive_opacity": 0.96,
        "fullscreen_opacity": 1.0,
        "dim_inactive": true,
        "dim_strength": 0.06
      },
      "terminal": { "background_opacity": 0.78 }
    },

    "frosted": {
      "label": "Frosted",
      "description": "The shipped default. Medium blur, a tint you can read text on, one soft shadow.",
      "blur": {
        "enabled": true,
        "variant": "kawase",
        "size": 10,
        "passes": 3,
        "noise": 0.02,
        "contrast": 0.9,
        "brightness": 1.0,
        "vibrancy": 0.2,
        "xray": false,
        "ignore_opacity": true,
        "new_optimizations": true,
        "popups": true,
        "special": false
      },
      "glass": {
        "tint_alpha": 0.34,
        "tint_alpha_strong": 0.48,
        "border_alpha": 0.18,
        "highlight_alpha": 0.1,
        "shadow_alpha": 0.36
      },
      "shadow": {
        "enabled": true,
        "range": 26,
        "render_power": 2,
        "color": "#000000",
        "color_inactive": "#000000",
        "offset": [0, 6],
        "scale": 1.0,
        "sharp": false
      },
      "window": {
        "active_opacity": 1.0,
        "inactive_opacity": 0.94,
        "fullscreen_opacity": 1.0,
        "dim_inactive": true,
        "dim_strength": 0.08
      },
      "terminal": { "background_opacity": 0.8 }
    },

    "soft": {
      "label": "Soft",
      "description": "Light blur under a heavier tint: the surface reads as frosted paint rather than glass. Cheaper than frosted and easier on integrated GPUs.",
      "blur": {
        "enabled": true,
        "variant": "kawase",
        "size": 6,
        "passes": 2,
        "noise": 0.025,
        "contrast": 0.88,
        "brightness": 1.0,
        "vibrancy": 0.14,
        "xray": false,
        "ignore_opacity": true,
        "new_optimizations": true,
        "popups": false,
        "special": false
      },
      "glass": {
        "tint_alpha": 0.52,
        "tint_alpha_strong": 0.64,
        "border_alpha": 0.16,
        "highlight_alpha": 0.08,
        "shadow_alpha": 0.28
      },
      "shadow": {
        "enabled": true,
        "range": 20,
        "render_power": 2,
        "color": "#000000",
        "color_inactive": "#000000",
        "offset": [0, 5],
        "scale": 1.0,
        "sharp": false
      },
      "window": {
        "active_opacity": 1.0,
        "inactive_opacity": 0.92,
        "fullscreen_opacity": 1.0,
        "dim_inactive": true,
        "dim_strength": 0.1
      },
      "terminal": { "background_opacity": 0.86 }
    },

    "performance": {
      "label": "Performance",
      "description": "Blur off, no drop shadows, solid translucent fills. Same colours, same radii, nothing that costs a framebuffer pass. Every generator must produce a working configuration from this intensity.",
      "blur": {
        "enabled": false,
        "variant": "kawase",
        "size": 0,
        "passes": 0,
        "noise": 0.0,
        "contrast": 1.0,
        "brightness": 1.0,
        "vibrancy": 0.0,
        "xray": false,
        "ignore_opacity": false,
        "new_optimizations": true,
        "popups": false,
        "special": false
      },
      "glass": {
        "tint_alpha": 0.92,
        "tint_alpha_strong": 0.96,
        "border_alpha": 0.14,
        "highlight_alpha": 0.0,
        "shadow_alpha": 0.0
      },
      "shadow": {
        "enabled": false,
        "range": 0,
        "render_power": 3,
        "color": "#000000",
        "color_inactive": "#000000",
        "offset": [0, 0],
        "scale": 1.0,
        "sharp": false
      },
      "window": {
        "active_opacity": 1.0,
        "inactive_opacity": 0.9,
        "fullscreen_opacity": 1.0,
        "dim_inactive": false,
        "dim_strength": 0.0
      },
      "terminal": { "background_opacity": 0.94 }
    }
  },

  "layout": {
    "gaps_in": 6,
    "gaps_out": 12,
    "float_gaps": 8,
    "border_size": 1,
    "resize_on_border": true,
    "border": {
      "angle_deg": 135,
      "active": {
        "from_role": "primary",
        "from_alpha": 0.55,
        "to_role": "secondary",
        "to_alpha": 0.14
      },
      "inactive": { "color": "#ffffff", "alpha": 0.1 }
    },
    "_note": "general:gaps_in/gaps_out accept a CSS-like gap value; a plain integer is what the shipped theme.lua already uses. Border colours are emitted as a gradient table { colors = {...}, angle = <degrees> }, the form CLuaConfigGradient::parse accepts."
  },

  "app_classes": {
    "terminal": ["^kitty$", "^foot$", "^Alacritty$", "^org\\.wezfurlong\\.wezterm$"],
    "file_manager": ["^[Tt]hunar$", "^org\\.kde\\.dolphin$", "^[Nn]autilus$", "^org\\.gnome\\.Nautilus$"],
    "editor": ["^[Cc]ode$", "^code-oss$", "^code-url-handler$", "^obsidian$", "^gedit$", "^org\\.gnome\\.TextEditor$"],
    "iarch_app": ["^dev\\.safari\\.iarch$", "^iarch-settings$", "^nwg-look$", "^nwg-displays$", "^org\\.pulseaudio\\.pavucontrol$", "^io\\.missioncenter\\.MissionCenter$", "^org\\.gnome\\.Calculator$", "^gcolor3$", "^org\\.gnome\\.FileRoller$", "^gnome-disks$"],
    "browser": ["^firefox$", "^org\\.mozilla\\.firefox$", "^[Ll]ibre[Ww]olf$", "^floorp$", "^brave-browser$", "^chromium$", "^zen$", "^vivaldi$"],
    "video": ["^mpv$", "^vlc$", "^org\\.videolan\\.vlc$", "^dragon$", "^org\\.kde\\.haruna$", "^deadbeef$", "^rhythmbox$", "^org\\.kde\\.elisa$", "^com\\.github\\.rafostar\\.Clapper$", "^celluloid$", "^io\\.github\\.celluloid_player\\.Celluloid$", "^obs$"],
    "opaque_always": ["^steam$", "^[Ss]team$", "^steamwebhelper$", "^lutris$", "^heroic$", "^com\\.heroicgameslauncher\\.hgl$", "^gamescope$", "^prismlauncher$", "^org\\.prismlauncher\\.PrismLauncher$", "^mangohud$"],
    "_note": "Groups map to window_rule opacity. Only classes for applications install.sh or fedora_install.sh actually offer are listed; browsers and video players are pinned to 1.0 because translucent video and translucent page content are unreadable, and games get no blur or opacity change at all. The escaped dots follow the regex style already used in .config/hypr/windowrules.lua."
  },

  "window_opacity": {
    "terminal": 0.82,
    "file_manager": 0.9,
    "editor": 0.92,
    "iarch_app": 0.88,
    "browser": 1.0,
    "video": 1.0,
    "opaque_always": 1.0,
    "fullscreen_override": 1.0
  },

  "surfaces": {
    "_note": "Layer rules for the Noctalia surfaces. The namespaces below are the documented, expected ones and are NOT verified against a running session in this environment: docs/UNVERIFIED.md SES-02. Run `iarch-doctor layers` inside the session and replace any name that differs; a layer rule that matches no namespace is harmless, it simply never applies.",
    "verified": false,
    "entries": [
      {
        "id": "bar",
        "namespace": "^noctalia-bar$",
        "blur": true,
        "ignore_alpha": 0.02,
        "xray": true,
        "description": "Top bar. xray keeps the bar from blurring the dock or a floating panel behind it."
      },
      {
        "id": "dock",
        "namespace": "^noctalia-dock$",
        "blur": true,
        "ignore_alpha": 0.02,
        "xray": true,
        "description": "Dock with magnification."
      },
      {
        "id": "launcher",
        "namespace": "^noctalia-launcher$",
        "blur": true,
        "ignore_alpha": 0.05,
        "xray": false,
        "dim_around": true,
        "description": "Application launcher, opened centred over the desktop."
      },
      {
        "id": "control_center",
        "namespace": "^noctalia-control-center$",
        "blur": true,
        "ignore_alpha": 0.05,
        "xray": false,
        "description": "Control centre popup."
      },
      {
        "id": "notifications",
        "namespace": "^noctalia-notifications$",
        "blur": true,
        "ignore_alpha": 0.05,
        "xray": false,
        "description": "Notification cards."
      },
      {
        "id": "settings",
        "namespace": "^noctalia-settings$",
        "blur": true,
        "ignore_alpha": 0.05,
        "xray": false,
        "description": "Shell settings window (shell.settings_window_translucent)."
      },
      {
        "id": "lock",
        "namespace": "^noctalia-lock$",
        "blur": true,
        "ignore_alpha": 0.02,
        "xray": true,
        "above_lock": 2,
        "description": "Lock-screen surface."
      },
      {
        "id": "clipboard",
        "namespace": "^noctalia-clipboard$",
        "blur": true,
        "ignore_alpha": 0.05,
        "xray": false,
        "description": "Clipboard history popup."
      },
      {
        "id": "session",
        "namespace": "^noctalia-session$",
        "blur": true,
        "ignore_alpha": 0.05,
        "xray": false,
        "dim_around": true,
        "description": "Session (logout/power) dialog."
      },
      {
        "id": "polkit",
        "namespace": "^noctalia-polkit$",
        "blur": true,
        "ignore_alpha": 0.05,
        "xray": false,
        "description": "Polkit authentication dialog."
      }
    ]
  },

  "hyprland": {
    "verified_against": "v0.57.2",
    "source": "src/config/values/ConfigValues.cpp, src/config/lua/types/LuaConfigGradient.cpp, src/config/shared/parserUtils/ParserUtils.cpp, src/desktop/rule/Rule.cpp, src/config/lua/bindings/LuaBindingsConfigRules.cpp",
    "_note": "The generator refuses to emit a leaf that is not listed here, so an invented key fails in CI instead of in the user's session. Ranges are the min/max Hyprland itself enforces.",
    "leaves": [
      "general:border_size", "general:gaps_in", "general:gaps_out", "general:float_gaps",
      "general:resize_on_border", "general:col.active_border", "general:col.inactive_border",
      "decoration:rounding", "decoration:rounding_power",
      "decoration:active_opacity", "decoration:inactive_opacity", "decoration:fullscreen_opacity",
      "decoration:dim_inactive", "decoration:dim_strength", "decoration:dim_modal",
      "decoration:blur:enabled", "decoration:blur:variant", "decoration:blur:size",
      "decoration:blur:passes", "decoration:blur:noise", "decoration:blur:contrast",
      "decoration:blur:brightness", "decoration:blur:vibrancy", "decoration:blur:xray",
      "decoration:blur:ignore_opacity", "decoration:blur:new_optimizations",
      "decoration:blur:popups", "decoration:blur:special",
      "decoration:shadow:enabled", "decoration:shadow:range", "decoration:shadow:render_power",
      "decoration:shadow:color", "decoration:shadow:color_inactive",
      "decoration:shadow:offset", "decoration:shadow:scale", "decoration:shadow:sharp"
    ],
    "ranges": {
      "decoration:rounding": [0, 100],
      "decoration:rounding_power": [1, 10],
      "decoration:active_opacity": [0, 1],
      "decoration:inactive_opacity": [0, 1],
      "decoration:fullscreen_opacity": [0, 1],
      "decoration:dim_strength": [0, 1],
      "decoration:blur:size": [0, 100],
      "decoration:blur:passes": [0, 10],
      "decoration:blur:noise": [0, 1],
      "decoration:blur:contrast": [0, 2],
      "decoration:blur:brightness": [0, 2],
      "decoration:blur:vibrancy": [0, 1],
      "decoration:shadow:range": [0, 100],
      "decoration:shadow:render_power": [1, 4],
      "decoration:shadow:scale": [0.01, 2],
      "general:border_size": [0, 20]
    },
    "blur_variants": [
      "kawase", "frost", "ripple", "drops", "water", "fluid_jar", "prism",
      "heat_shimmer", "acrylic", "aurora", "haze"
    ],
    "animated_blur_variants": ["ripple", "drops", "water", "fluid_jar", "heat_shimmer", "aurora"],
    "window_rule_effects": [
      "opacity", "rounding", "rounding_power", "border_size", "border_color",
      "no_blur", "no_shadow", "no_dim", "no_glow", "no_anim", "opaque",
      "decorate", "float", "animation", "idle_inhibit", "xray", "dim_around",
      "nearest_neighbor", "render_unfocused", "sync_fullscreen", "immediate"
    ],
    "window_rule_effects_note": "Every name above appears in WINDOW_RULE_EFFECT_DESCS in src/config/lua/bindings/LuaBindingsInternal.hpp at v0.57.2. There is no no_rounding effect: rounding is disabled per window with rounding = 0.",
    "layer_rule_effects": [
      "blur", "blur_popups", "ignore_alpha", "no_anim", "dim_around", "xray",
      "animation", "order", "above_lock", "no_screen_share"
    ],
    "rule_match_properties": [
      "class", "title", "initial_class", "initial_title", "float", "tag",
      "xwayland", "fullscreen", "pin", "focus", "group", "modal",
      "fullscreen_state_internal", "fullscreen_state_client", "workspace",
      "content", "xdg_tag", "namespace"
    ]
  }
}
