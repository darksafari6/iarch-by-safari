{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/darksafari6/iarch-by-safari/data/schemas/hyprlock.schema.json",
  "title": "hyprlock / hypridle surface",
  "description": "The verified configuration surface behind .config/hypr/hyprlock.conf and the unlaunched .config/hypr/hypridle.conf fallback. Every variable a generator may emit has to be recorded here with its documented type and default, because hyprlock only warns about an unknown variable: a typo ships a lock screen that still appears and a setting that silently does nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_copyright",
    "version",
    "tool",
    "verified_against",
    "source",
    "_note",
    "search_path",
    "sections",
    "widgets",
    "substitutions",
    "keys_and_signals",
    "not_in_hyprlock",
    "hypridle_fallback"
  ],
  "properties": {
    "_copyright": {
      "type": "string",
      "pattern": "Copyright \\(C\\) 2026 Safari"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tool": {
      "type": "string",
      "enum": [
        "hyprlock"
      ]
    },
    "verified_against": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "_note": {
      "type": "string",
      "minLength": 1
    },
    "search_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_path_note": {
      "type": "string"
    },
    "arch_linux_note": {
      "type": "string"
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/block"
      }
    },
    "widgets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/block"
      }
    },
    "substitutions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\$[A-Z0-9]+$"
          }
        }
      }
    },
    "keys_and_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_keys",
        "signals"
      ],
      "properties": {
        "default_keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "locked_flag_note": {
          "type": "string"
        },
        "signals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "pattern": "^SIG[A-Z0-9]+$"
          }
        }
      }
    },
    "not_in_hyprlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "items"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hypridle_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "path",
        "required",
        "note",
        "general_keys",
        "listener_keys"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "hypridle"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "hypridle\\.conf$"
        },
        "required": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "general_keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/variable"
          }
        },
        "listener_keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/variable"
          }
        },
        "listeners_note": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "block": {
      "description": "One config block (general { }, background { }, ...) or one shared group of variables (positioning, shadowable, clickable).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "table": {
          "type": "string",
          "description": "How the block is spelled in the file, e.g. 'input-field { }'."
        },
        "note": {
          "type": "string"
        },
        "not_used_note": {
          "type": "string",
          "description": "Why a verified block is recorded but never emitted."
        },
        "shadowable": {
          "type": "boolean"
        },
        "clickable": {
          "type": "boolean"
        },
        "keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/variable"
          }
        },
        "repeated": {
          "type": "object",
          "description": "Keywords that may appear more than once in the block (bezier, animation).",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/variable"
          }
        },
        "tree": {
          "type": "object",
          "description": "The animation tree: a group name mapped to the animation names under it.",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tree_note": {
          "type": "string"
        }
      }
    },
    "variable": {
      "description": "One hyprlock or hypridle variable: its type, its documented default, and the citation that makes it a fact rather than a guess.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bool",
            "int",
            "float",
            "string",
            "color",
            "gradient",
            "layoutxy"
          ]
        },
        "default": {
          "description": "The documented default, or null when the manual gives none."
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "enum": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "enum_note": {
          "type": "string",
          "description": "Where the vocabulary comes from, when there is no named constant to cite. hyprlock documents its enumerations inline in the variable table, so this is the honest citation."
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "[minimum, maximum] the manual states for this variable."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enum"
            ]
          },
          "then": {
            "required": [
              "enum",
              "enum_note"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "float"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
