{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/darksafari6/iarch-by-safari/data/schemas/theme-pack-wallpaper.schema.json",
  "title": "Dynamic theme procedural wallpaper recipe",
  "description": "Data-only recipe; colours and sizes are references to the enclosing pack. Rendering is deferred to a later milestone.",
  "type": "object",
  "required": [
    "_copyright",
    "schema_version",
    "id",
    "kind",
    "seed",
    "colors",
    "size"
  ],
  "additionalProperties": false,
  "properties": {
    "_copyright": {
      "const": "Copyright (C) 2026 Safari — GPL-3.0-or-later"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "gradient",
        "mesh",
        "radial"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "colors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "size": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  }
}
