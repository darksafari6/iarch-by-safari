{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/darksafari6/iarch-by-safari/data/schemas/greeter.schema.json",
  "title": "greetd / noctalia-greeter surface",
  "description": "The verified configuration surface of the login screen: greetd's two-table config, the greeter's declarative greeter.toml, the mutable sync.toml that Sync writes, and the contract between this repository's palette files and the sixteen colours the greeter requires. No generator reads this document, because this project ships no login-screen file; it exists so that the absence is evidenced rather than assumed, and so that the four places where the greeter's documentation disagrees with its code are written down next to the values the code actually honours.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_copyright",
    "version",
    "tool",
    "verified_against",
    "shell_verified_against",
    "source",
    "_note",
    "release_note",
    "main_only_keys",
    "greetd_config",
    "state_directory",
    "greeter_toml",
    "sync_toml",
    "sync",
    "palette_contract",
    "pam",
    "cli",
    "motion",
    "not_shipped",
    "not_in_greeter",
    "doc_disagreements",
    "installer"
  ],
  "properties": {
    "_copyright": {
      "type": "string",
      "pattern": "Copyright \\(C\\) 2026 Safari"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tool": {
      "type": "string",
      "enum": [
        "noctalia-greeter"
      ]
    },
    "verified_against": {
      "type": "string",
      "minLength": 1,
      "description": "The greeter release this record was read from, with the fetch date."
    },
    "shell_verified_against": {
      "type": "string",
      "minLength": 1,
      "description": "The shell release the Sync client side was read from. Two projects are involved, so two versions are pinned."
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "_note": {
      "type": "string",
      "minLength": 1
    },
    "release_note": {
      "type": "string",
      "minLength": 1,
      "description": "Why a pinned tag and a -git package can still describe the same release, and for how long that is a fact rather than a promise."
    },
    "main_only_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "keys"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/variable"
          }
        }
      }
    },
    "greetd_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "note",
        "source",
        "upstream_template",
        "upstream_template_source",
        "template_difference_note",
        "tables"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/etc/greetd/config\\.toml$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/definitions/citation"
        },
        "tables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal",
            "default_session"
          ],
          "properties": {
            "terminal": {
              "$ref": "#/definitions/keymap"
            },
            "default_session": {
              "$ref": "#/definitions/keymap"
            }
          }
        },
        "upstream_template": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          },
          "description": "The block upstream's own helper prints, verbatim, so that a test can compare it with what the installers write without reaching the network."
        },
        "upstream_template_source": {
          "$ref": "#/definitions/citation"
        },
        "template_difference_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state_directory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "constant",
        "source",
        "env_override",
        "mode",
        "mode_constant",
        "mode_source",
        "file_mode",
        "file_mode_constant",
        "file_mode_source",
        "owner",
        "files",
        "staging_directory",
        "tmpfiles_dropin"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/var/lib/noctalia-greeter$"
        },
        "constant": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/definitions/citation"
        },
        "env_override": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "source",
            "note"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^NOCTALIA_GREETER_"
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mode": {
          "$ref": "#/definitions/file_mode"
        },
        "mode_constant": {
          "type": "string",
          "minLength": 1
        },
        "mode_source": {
          "$ref": "#/definitions/citation"
        },
        "file_mode": {
          "$ref": "#/definitions/file_mode"
        },
        "file_mode_constant": {
          "type": "string",
          "minLength": 1
        },
        "file_mode_source": {
          "$ref": "#/definitions/citation"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "staging_directory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "fallback",
            "source",
            "note"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "fallback": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tmpfiles_dropin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "source",
            "line",
            "note"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "tmpfiles\\.d/noctalia-greeter\\.conf$"
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "line": {
              "type": "string",
              "pattern": "^d /var/lib/noctalia-greeter 0750 ",
              "description": "The drop-in line verbatim, so the recorded mode and owner can be compared with it."
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "greeter_toml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "parser_note",
        "empty_string_note",
        "sections"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "greeter\\.toml$"
        },
        "parser_note": {
          "type": "string",
          "minLength": 1
        },
        "empty_string_note": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session",
            "user",
            "appearance",
            "clock",
            "output",
            "idle",
            "cursor",
            "keyboard",
            "auth"
          ],
          "properties": {
            "session": {
              "$ref": "#/definitions/keymap"
            },
            "user": {
              "$ref": "#/definitions/keymap"
            },
            "appearance": {
              "$ref": "#/definitions/keymap"
            },
            "clock": {
              "$ref": "#/definitions/keymap"
            },
            "output": {
              "$ref": "#/definitions/keymap"
            },
            "idle": {
              "$ref": "#/definitions/keymap"
            },
            "cursor": {
              "$ref": "#/definitions/keymap"
            },
            "keyboard": {
              "$ref": "#/definitions/keymap"
            },
            "auth": {
              "$ref": "#/definitions/keymap"
            }
          }
        }
      }
    },
    "sync_toml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "note",
        "source",
        "keys",
        "session_payload_note"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "sync\\.toml$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/definitions/citation"
        },
        "keys": {
          "type": "object",
          "minProperties": 5,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_payload_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "ipc",
        "availability",
        "copies",
        "excludes",
        "source",
        "precedence",
        "auto_sync",
        "authorization",
        "helper_protocol",
        "staged_payload_note"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "ipc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "source",
            "note"
          ],
          "properties": {
            "command": {
              "type": "string",
              "pattern": "^noctalia msg greeter-sync$"
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requires",
            "source"
          ],
          "properties": {
            "requires": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "source": {
              "$ref": "#/definitions/citation"
            }
          }
        },
        "copies": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludes": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "$ref": "#/definitions/citation"
        },
        "precedence": {
          "type": "string",
          "minLength": 1
        },
        "auto_sync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "default",
            "source",
            "note",
            "why_not_shipped"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "auto_sync$"
            },
            "default": {
              "type": "boolean"
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "why_not_shipped": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "policy_source",
            "defaults",
            "matches_only",
            "note",
            "legacy_action_warning",
            "agent_requirement",
            "trusted_install_requirement",
            "version_requirement"
          ],
          "properties": {
            "action_id": {
              "type": "string",
              "pattern": "^org\\.noctalia\\.greeter\\."
            },
            "policy_source": {
              "$ref": "#/definitions/citation"
            },
            "defaults": {
              "type": "string",
              "minLength": 1
            },
            "matches_only": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "legacy_action_warning": {
              "type": "string",
              "minLength": 1
            },
            "agent_requirement": {
              "type": "string",
              "minLength": 1
            },
            "trusted_install_requirement": {
              "type": "string",
              "minLength": 1
            },
            "version_requirement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "helper_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values",
            "source",
            "note"
          ],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "enum": [
                  "Unknown",
                  "Legacy",
                  "SecureSyncV1"
                ]
              }
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "staged_payload_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "palette_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "required_keys_source",
        "mapping_source",
        "palette_file_source",
        "mapping",
        "round_trip_note",
        "dropped_keys_note"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "required_keys_source": {
          "$ref": "#/definitions/citation"
        },
        "mapping_source": {
          "$ref": "#/definitions/citation"
        },
        "palette_file_source": {
          "$ref": "#/definitions/citation"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "on_primary",
            "secondary",
            "on_secondary",
            "tertiary",
            "on_tertiary",
            "error",
            "on_error",
            "surface",
            "on_surface",
            "surface_variant",
            "on_surface_variant",
            "outline",
            "shadow",
            "hover",
            "on_hover"
          ],
          "properties": {
            "primary": {
              "$ref": "#/definitions/palette_field"
            },
            "on_primary": {
              "$ref": "#/definitions/palette_field"
            },
            "secondary": {
              "$ref": "#/definitions/palette_field"
            },
            "on_secondary": {
              "$ref": "#/definitions/palette_field"
            },
            "tertiary": {
              "$ref": "#/definitions/palette_field"
            },
            "on_tertiary": {
              "$ref": "#/definitions/palette_field"
            },
            "error": {
              "$ref": "#/definitions/palette_field"
            },
            "on_error": {
              "$ref": "#/definitions/palette_field"
            },
            "surface": {
              "$ref": "#/definitions/palette_field"
            },
            "on_surface": {
              "$ref": "#/definitions/palette_field"
            },
            "surface_variant": {
              "$ref": "#/definitions/palette_field"
            },
            "on_surface_variant": {
              "$ref": "#/definitions/palette_field"
            },
            "outline": {
              "$ref": "#/definitions/palette_field"
            },
            "shadow": {
              "$ref": "#/definitions/palette_field"
            },
            "hover": {
              "$ref": "#/definitions/palette_field"
            },
            "on_hover": {
              "$ref": "#/definitions/palette_field"
            }
          }
        },
        "round_trip_note": {
          "type": "string",
          "minLength": 1
        },
        "dropped_keys_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "setup_greetd_pam",
        "fingerprint_note",
        "faillock_note"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "setup_greetd_pam": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "source",
            "behaviour",
            "why_it_matters"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "setup_greetd_pam\\.sh$"
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "behaviour": {
              "type": "string",
              "minLength": 1
            },
            "why_it_matters": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fingerprint_note": {
          "type": "string",
          "minLength": 1
        },
        "faillock_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary",
        "source",
        "commands",
        "options",
        "environment"
      ],
      "properties": {
        "binary": {
          "type": "string",
          "pattern": "^noctalia-greeter$"
        },
        "source": {
          "$ref": "#/definitions/citation"
        },
        "commands": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "options": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "pattern": "^-"
          }
        },
        "environment": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "easings",
        "easings_source",
        "overshoot_note",
        "corner_radius_note",
        "wallpaper_transition_note"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "easings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "Linear",
              "EaseInCubic",
              "EaseOutCubic",
              "EaseInOutCubic",
              "EaseOutBack"
            ]
          }
        },
        "easings_source": {
          "$ref": "#/definitions/citation"
        },
        "overshoot_note": {
          "type": "string",
          "minLength": 1
        },
        "corner_radius_note": {
          "type": "string",
          "minLength": 1
        },
        "wallpaper_transition_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "not_shipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "greeter_toml",
        "shell_greeter_sync",
        "shell_polkit_agent"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "greeter_toml": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what",
            "why",
            "what_sync_covers_instead"
          ],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 1
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "what_sync_covers_instead": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "shell_greeter_sync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what",
            "source",
            "why"
          ],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "why": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "shell_polkit_agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what",
            "default",
            "source",
            "why",
            "inert_payload_note"
          ],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 1
            },
            "default": {
              "type": "boolean"
            },
            "source": {
              "$ref": "#/definitions/citation"
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "inert_payload_note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "not_in_greeter": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What the surface cannot do, stated as plainly as what it can."
    },
    "doc_disagreements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "docs_say",
          "code_does",
          "consequence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "docs_say": {
            "type": "string",
            "minLength": 1
          },
          "code_does": {
            "type": "string",
            "minLength": 1
          },
          "recorded_default": {
            "description": "The value this record keeps, when the disagreement is about a default."
          },
          "recorded_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "functions",
        "steps",
        "agreements_with_upstream",
        "drift_found",
        "not_changed"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "functions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "install.sh",
            "fedora_install.sh"
          ],
          "properties": {
            "install.sh": {
              "$ref": "#/definitions/citation"
            },
            "fedora_install.sh": {
              "$ref": "#/definitions/citation"
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agreements_with_upstream": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "drift_found": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what",
            "why_it_matters",
            "fix"
          ],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 1
            },
            "why_it_matters": {
              "type": "string",
              "minLength": 1
            },
            "fix": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "not_changed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "citation": {
      "description": "A citation has to name a file, so that a reader can go and check it. Prose that only says 'see the documentation' is not a citation and this pattern refuses it.",
      "type": "string",
      "minLength": 8,
      "pattern": "\\.(cpp|h|c|md|mdx|sh|toml|in|build|json|lua|desktop)(:|$|[ ,)])"
    },
    "file_mode": {
      "type": "string",
      "pattern": "^0[0-7]{3}$"
    },
    "palette_field": {
      "description": "The camelCase key in this repository's palette files that Sync renames to the greeter's snake_case key.",
      "type": "string",
      "pattern": "^m[A-Z][A-Za-z]*$"
    },
    "keymap": {
      "description": "One TOML table of the recorded file: an optional note about the table as a whole, and its keys.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/variable"
          }
        }
      }
    },
    "variable": {
      "description": "One key of the recorded surface: its type, the default the code actually honours, and the citation that makes both facts rather than guesses. A *_note property carries any qualification the key needs, which is why the note vocabulary is open-ended while the rest is not.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bool",
            "int",
            "float",
            "string",
            "color",
            "table",
            "map"
          ]
        },
        "default": {
          "description": "The default the code applies, or null when the key has none. An empty string means 'unset' to this parser, and is recorded as such rather than as null."
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/definitions/citation"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "The accepted vocabulary. A single entry is allowed here, unlike the hyprlock surface, because one greeter key has exactly one name with a constant behind it."
        },
        "enum_note": {
          "type": "string",
          "minLength": 1,
          "description": "Where the vocabulary comes from and whether the greeter enforces it. Three of the recorded enumerations are documentation only, and each says so."
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "[minimum, maximum] the code enforces — which for two keys is narrower than what the parser accepts."
        },
        "range_note": {
          "type": "string",
          "minLength": 1
        },
        "env_override": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "object",
          "description": "The sub-keys of a table-valued key.",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/variable"
          }
        },
        "runtime_migrated": {
          "type": "boolean",
          "description": "True when the key is parsed only so an old file does not warn, and is moved into sync.toml on the next write."
        },
        "security_relevant": {
          "type": "boolean",
          "description": "True when the key changes what reaches an authentication stack."
        },
        "doc_disagreement": {
          "type": "boolean",
          "description": "True when an entry in doc_disagreements is about this key. The entry's id is not repeated here; a test walks both sides of the reference."
        }
      },
      "patternProperties": {
        "^[a-z][a-z0-9_]*_note$": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enum"
            ]
          },
          "then": {
            "required": [
              "enum",
              "enum_note"
            ]
          }
        },
        {
          "if": {
            "required": [
              "range"
            ]
          },
          "then": {
            "required": [
              "range",
              "range_note"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "float"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "map"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "color"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
