{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/darksafari6/iarch-by-safari/data/schemas/theme-ids.schema.json",
  "title": "iArch session theme ID index",
  "type": "object",
  "required": [
    "_copyright",
    "default",
    "choice_file",
    "apply_command",
    "status",
    "themes",
    "note"
  ],
  "additionalProperties": false,
  "properties": {
    "default": {
      "enum": [
        "greenhouse",
        "amber-bloom",
        "neon-rain",
        "forest-night",
        "violet-glass",
        "crimson-silk"
      ]
    },
    "choice_file": {
      "const": "~/.config/iarch/theme.json"
    },
    "apply_command": {
      "const": "iarch-theme apply"
    },
    "status": {
      "const": "theme-packs"
    },
    "themes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "greenhouse",
              "amber-bloom",
              "neon-rain",
              "forest-night",
              "violet-glass",
              "crimson-silk"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 10
    },
    "_copyright": {
      "type": "string",
      "const": "Copyright (C) 2026 Safari — GPL-3.0-or-later"
    }
  },
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later"
}
