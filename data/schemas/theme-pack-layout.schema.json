                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "uniqueItems": true
            }
          }
        },
        "dock": {
          "type": "object",
          "required": [
            "enabled",
            "variant",
            "position",
            "size",
            "order"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
