                "right",
                "center"
              ]
            },
            "size": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "uniqueItems": true
            }
          }
        },
        "osk": {
          "type": "object",
          "required": [
