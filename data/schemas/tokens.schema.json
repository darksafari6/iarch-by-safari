{
  "_copyright": "Copyright (C) 2026 Safari — GPL-3.0-or-later",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/darksafari6/iarch-by-safari/data/schemas/tokens.schema.json",
  "title": "iArch by Safari glass design tokens",
  "description": "Schema for data/design/tokens.json. Numeric bounds that mirror a Hyprland config leaf are set to the min/max Hyprland itself enforces at v0.57.2, so a token that could never be applied fails here instead of in the user's session. Design-only values with no compositor equivalent (radius.pill) are unconstrained; iarch/cli clamps them per target.",
  "type": "object",
  "required": [
    "version",
    "name",
    "radius",
    "spacing",
    "motion",
    "font",
    "accent",
    "default_intensity",
    "intensities",
    "modes",
    "layout",
    "app_classes",
    "window_opacity",
    "surfaces",
    "hyprland"
  ],
  "additionalProperties": false,
  "properties": {
    "_copyright": { "type": "string" },
    "_generated": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "docs": { "type": "string" },

    "radius": {
      "type": "object",
      "required": ["xs", "sm", "md", "lg", "pill", "check", "power", "window", "panel", "card", "button", "input", "tooltip"],
      "additionalProperties": false,
      "properties": {
        "xs": { "type": "integer", "minimum": 0, "maximum": 100 },
        "sm": { "type": "integer", "minimum": 0, "maximum": 100 },
        "md": { "type": "integer", "minimum": 0, "maximum": 100 },
        "lg": { "type": "integer", "minimum": 0, "maximum": 100 },
        "pill": { "type": "integer", "minimum": 100 },
        "check": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "A check box corner. Kept small on purpose: radius.pill would make a 16px indicator fully round, and GTK draws a check mark inside it that needs straight sides to read."
        },
        "power": { "type": "number", "minimum": 1, "maximum": 10 },
        "window": { "$ref": "#/definitions/radius_role" },
        "panel": { "$ref": "#/definitions/radius_role" },
        "card": { "$ref": "#/definitions/radius_role" },
        "button": { "$ref": "#/definitions/radius_role" },
        "input": { "$ref": "#/definitions/radius_role" },
        "tooltip": { "$ref": "#/definitions/radius_role" }
      }
    },

    "spacing": {
      "type": "object",
      "required": ["xs", "sm", "md", "lg", "xl", "xxl"],
      "additionalProperties": false,
      "properties": {
        "xs": { "type": "integer", "minimum": 0 },
        "sm": { "type": "integer", "minimum": 0 },
        "md": { "type": "integer", "minimum": 0 },
        "lg": { "type": "integer", "minimum": 0 },
        "xl": { "type": "integer", "minimum": 0 },
        "xxl": { "type": "integer", "minimum": 0 }
      }
    },

    "motion": {
      "type": "object",
      "required": ["fast_ms", "normal_ms", "slow_ms", "easing", "spring", "animation"],
      "additionalProperties": false,
      "properties": {
        "_note": { "type": "string" },
        "fast_ms": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "normal_ms": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "slow_ms": { "type": "integer", "minimum": 0, "maximum": 4000 },
        "easing": {
          "type": "object",
          "required": ["standard", "emphasized", "decelerate", "accelerate"],
          "additionalProperties": false,
          "properties": {
            "standard": { "$ref": "#/definitions/bezier" },
            "emphasized": { "$ref": "#/definitions/bezier" },
            "decelerate": { "$ref": "#/definitions/bezier" },
            "accelerate": { "$ref": "#/definitions/bezier" }
          }
        },
        "spring": {
          "type": "object",
          "required": ["stiffness", "damping", "mass"],
          "additionalProperties": false,
          "description": "hl.curve(name, { type = \"spring\", ... }) rejects any of the three at or below 0.5: LuaBindingsConfigRules.cpp parses each with CLuaConfigFloat and calls Internal::configError when the value is <= 0.5F, so the usable bound is strictly greater than 0.5 (exclusiveMinimum), not >= 0.5.",
          "properties": {
            "stiffness": { "type": "number", "exclusiveMinimum": 0.5 },
            "damping": { "type": "number", "exclusiveMinimum": 0.5 },
            "mass": { "type": "number", "exclusiveMinimum": 0.5 }
          }
        },
        "animation": {
          "type": "object",
          "required": ["default_preset", "presets", "speed_multiplier", "reduce_motion"],
          "additionalProperties": false,
          "description": "The compositor motion selection added in Part 3. The named curves and the per-event durations, curves and styles live in data/design/animations/<preset>.json (one file per preset, validated by data/schemas/animations_preset.schema.json), not here: this block only carries what every preset shares. 'presets' is the closed list iarch-anim accepts, and it must match the files on disk -- tests/test_animation_presets.py asserts the two agree, so a preset file with no name here, or a name here with no file, fails CI rather than failing in the user's session. Overshoot beziers are deliberately absent from 'easing' above: that vocabulary is shared with the GTK CSS renderer, cubic-bezier() requires every component inside [0,1] and tests/test_design_tokens.py enforces the unit square, whereas hl.curve accepts [-1, 2] per component. A preset that wants overshoot declares it in its own file.",
          "properties": {
            "_note": { "type": "string" },
            "default_preset": { "enum": ["smooth", "snappy", "bouncy", "minimal", "off"] },
            "presets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["smooth", "snappy", "bouncy", "minimal", "off"] }
            },
            "speed_multiplier": {
              "type": "object",
              "required": ["min", "max", "default"],
              "additionalProperties": false,
              "description": "The bounds iarch-anim clamps a global multiplier to. Greater than 1 is FASTER: effective_ms = duration_ms / multiplier, the same direction render_noctalia.py already uses for shell.animation (MOTION_BASELINE_MS / normal_ms).",
              "properties": {
                "min": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "max": { "type": "number", "minimum": 1, "maximum": 4 },
                "default": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "reduce_motion": {
              "type": "object",
              "required": ["preset", "max_duration_ms"],
              "additionalProperties": false,
              "description": "What 'iarch-anim reduce-motion on' resolves to: the named preset (fades only, no transform) with every duration capped at max_duration_ms.",
              "properties": {
                "preset": { "enum": ["smooth", "snappy", "bouncy", "minimal", "off"] },
                "max_duration_ms": { "type": "integer", "minimum": 1, "exclusiveMaximum": 100 }
              }
            }
          }
        }
      }
    },

    "font": {
      "type": "object",
      "required": ["ui", "mono", "emoji", "sizes", "weights", "line_height", "fallback"],
      "additionalProperties": false,
      "properties": {
        "_note": { "type": "string" },
        "ui": { "type": "string", "minLength": 1 },
        "ui_display": { "type": "string", "minLength": 1 },
        "mono": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string", "minLength": 1 },
        "sizes": {
          "type": "object",
          "required": ["xs", "sm", "md", "lg", "xl", "xxl"],
          "additionalProperties": false,
          "properties": {
            "xs": { "type": "integer", "minimum": 6, "maximum": 72 },
            "sm": { "type": "integer", "minimum": 6, "maximum": 72 },
            "md": { "type": "integer", "minimum": 6, "maximum": 72 },
            "lg": { "type": "integer", "minimum": 6, "maximum": 72 },
            "xl": { "type": "integer", "minimum": 6, "maximum": 72 },
            "xxl": { "type": "integer", "minimum": 6, "maximum": 128 }
          }
        },
        "weights": {
          "type": "object",
          "required": ["regular", "medium", "semibold", "bold"],
          "additionalProperties": false,
          "properties": {
            "regular": { "type": "integer", "minimum": 100, "maximum": 900 },
            "medium": { "type": "integer", "minimum": 100, "maximum": 900 },
            "semibold": { "type": "integer", "minimum": 100, "maximum": 900 },
            "bold": { "type": "integer", "minimum": 100, "maximum": 900 }
          }
        },
        "line_height": { "type": "number", "minimum": 1.0, "maximum": 2.5 },
        "fallback": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["family", "script"],
            "additionalProperties": false,
            "properties": {
              "family": { "type": "string", "minLength": 1 },
              "script": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "accent": { "$ref": "#/definitions/accent_roles" },

    "default_intensity": { "$ref": "#/definitions/intensity_name" },

    "intensities": {
      "type": "object",
      "required": ["crystal", "frosted", "soft", "performance"],
      "additionalProperties": false,
      "properties": {
        "crystal": { "$ref": "#/definitions/intensity" },
        "frosted": { "$ref": "#/definitions/intensity" },
        "soft": { "$ref": "#/definitions/intensity" },
        "performance": { "$ref": "#/definitions/intensity" }
      }
    },

    "modes": {
      "type": "object",
      "description": "The two mode switches added in Part 3: iarch-gamemode and iarch-focus. Neither invents a value. game.intensity must name one of the four intensities above, and the animation preset game mode applies is not repeated here on purpose -- it is the one intensities.<name>.motion already pairs with that intensity, read through gen_animations_lua.preset_for_intensity, so the two cannot disagree. focus.dim_strength must sit inside hyprland.ranges for the leaf it sets, and every name in focus.leaves must appear in hyprland.leaves, which is the list that makes a leaf emittable at all, whether a generator writes it or a mode sets it while the session runs. runtime records the compositor call both modes go through and the spelling of it that was rejected, with the evidence.",
      "required": ["_note", "runtime", "game", "focus"],
      "additionalProperties": false,
      "properties": {
        "_note": { "type": "string", "minLength": 1 },
        "runtime": {
          "type": "object",
          "description": "The four compositor calls a mode may make while the session runs, and the one it may not. Every value is a literal command shape rather than a description of one, so a test can compare what a tool actually sent against what this file says is possible. rejected_spelling is required, not optional: a mechanism this repository stopped using stays in the record with the evidence that it does not work, because the shipped manual still documents it and the next person to read that manual will otherwise write it again.",
          "required": ["set_via", "read_via", "errors_via", "reload_via", "source",
                       "_note", "rejected_spelling", "rejected_note"],
          "additionalProperties": false,
          "properties": {
            "set_via": {
              "type": "string", "pattern": "^hyprctl eval ",
              "description": "Must start with `hyprctl eval `. Nothing registers a keyword or setoption command at v0.57.2 (src/ipc/s1/Commands.cpp:2084-2126 lists the 38 that are registered, and only src/plugins/PluginAPI.cpp:357 may add one), so eval is the only request that can change a leaf in a running Lua-configured session."
            },
            "read_via": {
              "type": "string", "pattern": "^hyprctl getoption ",
              "description": "The read a verification compares against. dispatchGetOption answers one JSON object under -j and the literal `no such option` for a leaf it does not know, even under -j, which is why an unreadable leaf is reported as unverified rather than as a pass or a failure (src/ipc/s1/Commands.cpp:1717-1800)."
            },
            "errors_via": { "type": "string", "const": "hyprctl configerrors" },
            "reload_via": {
              "type": "string", "const": "hyprctl reload",
              "description": "Synchronous: reloadRequest re-parses the config and then answers ok, so a leaf read after it is the state now running rather than a state that is about to be (src/ipc/s1/Commands.cpp:1352-1370)."
            },
            "source": { "type": "string", "minLength": 1 },
            "_note": { "type": "string", "minLength": 1 },
            "rejected_spelling": { "type": "string", "minLength": 1 },
            "rejected_note": { "type": "string", "minLength": 1 }
          }
        },
        "game": {
          "type": "object",
          "required": ["intensity", "_note"],
          "additionalProperties": false,
          "properties": {
            "intensity": { "$ref": "#/definitions/intensity_name" },
            "_note": { "type": "string", "minLength": 1 }
          }
        },
        "focus": {
          "type": "object",
          "required": ["dim_inactive", "dim_strength", "leaves", "leaves_note", "_note"],
          "additionalProperties": false,
          "properties": {
            "dim_inactive": {
              "const": true,
              "description": "Focus mode without dimming would be Do Not Disturb plus caffeine, which are two control-centre tiles that already exist. The dim is the part only the compositor can do, so the switch is not optional here."
            },
            "dim_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The bounds hyprland.ranges records for decoration:dim_strength, which are the ones MS<Float> declares at src/config/values/ConfigValues.cpp:228 in v0.57.2. The shipped 0.5 is that leaf's own upstream default, handed back to the compositor while focusing; the four intensities lower it to 0.0-0.10."
            },
            "leaves": {
              "$ref": "#/definitions/string_list",
              "description": "The Hyprland leaves iarch-focus sets at runtime. Every entry must also be in hyprland.leaves; tests/test_focus.py asserts it, because a leaf set through runtime.eval is held to the same recorded-vocabulary rule as one a generator writes."
            },
            "leaves_note": { "type": "string", "minLength": 1 },
            "_note": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "layout": {
      "type": "object",
      "required": ["gaps_in", "gaps_out", "float_gaps", "border_size", "resize_on_border", "border"],
      "additionalProperties": false,
      "properties": {
        "_note": { "type": "string" },
        "gaps_in": { "type": "integer", "minimum": 0, "maximum": 100 },
        "gaps_out": { "type": "integer", "minimum": 0, "maximum": 100 },
        "float_gaps": { "type": "integer", "minimum": 0, "maximum": 100 },
        "border_size": { "type": "integer", "minimum": 0, "maximum": 20 },
        "resize_on_border": { "type": "boolean" },
        "border": {
          "type": "object",
          "required": ["angle_deg", "active", "inactive"],
          "additionalProperties": false,
          "properties": {
            "angle_deg": { "type": "number", "minimum": 0, "maximum": 360 },
            "active": {
              "type": "object",
              "required": ["from_role", "from_alpha", "to_role", "to_alpha"],
              "additionalProperties": false,
              "properties": {
                "from_role": { "$ref": "#/definitions/accent_role_name" },
                "from_alpha": { "$ref": "#/definitions/alpha" },
                "to_role": { "$ref": "#/definitions/accent_role_name" },
                "to_alpha": { "$ref": "#/definitions/alpha" }
              }
            },
            "inactive": {
              "type": "object",
              "required": ["color", "alpha"],
              "additionalProperties": false,
              "properties": {
                "color": { "$ref": "#/definitions/hex_color" },
                "alpha": { "$ref": "#/definitions/alpha" }
              }
            }
          }
        }
      }
    },

    "app_classes": {
      "type": "object",
      "required": ["terminal", "file_manager", "editor", "iarch_app", "browser", "video", "opaque_always"],
      "additionalProperties": false,
      "description": "Window-class regular expressions per opacity group. Values are RE2 patterns anchored the way .config/hypr/windowrules.lua already anchors them.",
      "properties": {
        "_note": { "type": "string" },
        "terminal": { "$ref": "#/definitions/class_list" },
        "file_manager": { "$ref": "#/definitions/class_list" },
        "editor": { "$ref": "#/definitions/class_list" },
        "iarch_app": { "$ref": "#/definitions/class_list" },
        "browser": { "$ref": "#/definitions/class_list" },
        "video": { "$ref": "#/definitions/class_list" },
        "opaque_always": { "$ref": "#/definitions/class_list" }
      }
    },

    "window_opacity": {
      "type": "object",
      "required": ["terminal", "file_manager", "editor", "iarch_app", "browser", "video", "opaque_always", "fullscreen_override"],
      "additionalProperties": false,
      "properties": {
        "terminal": { "$ref": "#/definitions/alpha" },
        "file_manager": { "$ref": "#/definitions/alpha" },
        "editor": { "$ref": "#/definitions/alpha" },
        "iarch_app": { "$ref": "#/definitions/alpha" },
        "browser": { "$ref": "#/definitions/alpha" },
        "video": { "$ref": "#/definitions/alpha" },
        "opaque_always": { "$ref": "#/definitions/alpha" },
        "fullscreen_override": { "$ref": "#/definitions/alpha" }
      }
    },

    "surfaces": {
      "type": "object",
      "required": ["verified", "entries"],
      "additionalProperties": false,
      "properties": {
        "_note": { "type": "string" },
        "verified": {
          "type": "boolean",
          "description": "False until the namespaces have been compared against `hyprctl layers` output from a running session."
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "namespace", "blur", "ignore_alpha", "xray", "description"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string", "minLength": 1 },
              "blur": { "type": "boolean" },
              "blur_popups": { "type": "boolean" },
              "ignore_alpha": { "$ref": "#/definitions/alpha" },
              "xray": { "type": "boolean" },
              "dim_around": { "type": "boolean" },
              "order": { "type": "integer" },
              "above_lock": { "type": "integer", "minimum": 0, "maximum": 2 },
              "no_screen_share": { "type": "boolean" },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "hyprland": {
      "type": "object",
      "required": ["verified_against", "source", "leaves", "integer_leaves", "ranges", "blur_variants", "animated_blur_variants", "window_rule_effects", "layer_rule_effects", "rule_match_properties"],
      "additionalProperties": false,
      "properties": {
        "_note": { "type": "string" },
        "verified_against": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "type": "string" },
        "leaves": { "$ref": "#/definitions/string_list" },
        "integer_leaves": { "$ref": "#/definitions/string_list" },
        "integer_leaves_note": { "type": "string" },
        "ranges": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "blur_variants": { "$ref": "#/definitions/string_list" },
        "animated_blur_variants": { "$ref": "#/definitions/string_list" },
        "window_rule_effects": { "$ref": "#/definitions/string_list" },
        "window_rule_effects_note": { "type": "string" },
        "layer_rule_effects": { "$ref": "#/definitions/string_list" },
        "rule_match_properties": { "$ref": "#/definitions/string_list" }
      }
    }
  },

  "definitions": {
    "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
    "hex_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "radius_role": { "enum": ["xs", "sm", "md", "lg", "pill"] },
    "accent_role_name": { "enum": ["primary", "secondary", "success", "warning", "danger"] },
    "intensity_name": { "enum": ["crystal", "frosted", "soft", "performance"] },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "class_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "accent_roles": {
      "type": "object",
      "required": ["primary", "secondary", "success", "warning", "danger"],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/definitions/hex_color" },
        "secondary": { "$ref": "#/definitions/hex_color" },
        "success": { "$ref": "#/definitions/hex_color" },
        "warning": { "$ref": "#/definitions/hex_color" },
        "danger": { "$ref": "#/definitions/hex_color" }
      }
    },
    "bezier": {
      "type": "object",
      "required": ["type", "points"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "bezier" },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "intensity": {
      "type": "object",
      "required": ["label", "description", "blur", "glass", "shadow", "glow", "window", "terminal", "shell", "gtk", "qt", "motion"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "blur": {
          "type": "object",
          "required": [
            "enabled", "variant", "size", "passes", "noise", "contrast",
            "brightness", "vibrancy", "xray", "ignore_opacity",
            "new_optimizations", "popups", "special"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "variant": { "enum": ["kawase", "frost", "ripple", "drops", "water", "fluid_jar", "prism", "heat_shimmer", "acrylic", "aurora", "haze"] },
            "size": { "type": "integer", "minimum": 0, "maximum": 100 },
            "passes": { "type": "integer", "minimum": 0, "maximum": 10 },
            "noise": { "type": "number", "minimum": 0, "maximum": 1 },
            "contrast": { "type": "number", "minimum": 0, "maximum": 2 },
            "brightness": { "type": "number", "minimum": 0, "maximum": 2 },
            "vibrancy": { "type": "number", "minimum": 0, "maximum": 1 },
            "xray": { "type": "boolean" },
            "ignore_opacity": { "type": "boolean" },
            "new_optimizations": { "type": "boolean" },
            "popups": { "type": "boolean" },
            "special": { "type": "boolean" }
          }
        },
        "glass": {
          "type": "object",
          "required": ["tint_alpha", "tint_alpha_strong", "border_alpha", "highlight_alpha", "shadow_alpha"],
          "additionalProperties": false,
          "properties": {
            "tint_alpha": { "$ref": "#/definitions/alpha" },
            "tint_alpha_strong": { "$ref": "#/definitions/alpha" },
            "border_alpha": { "$ref": "#/definitions/alpha" },
            "highlight_alpha": { "$ref": "#/definitions/alpha" },
            "shadow_alpha": { "$ref": "#/definitions/alpha" }
          }
        },
        "shadow": {
          "type": "object",
          "required": ["enabled", "range", "render_power", "color", "color_inactive", "offset", "scale", "sharp"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "range": { "type": "integer", "minimum": 0, "maximum": 100 },
            "render_power": { "type": "integer", "minimum": 1, "maximum": 4 },
            "color": { "$ref": "#/definitions/hex_color" },
            "color_inactive": { "$ref": "#/definitions/hex_color" },
            "offset": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            },
            "scale": { "type": "number", "minimum": 0.01, "maximum": 2 },
            "sharp": { "type": "boolean" }
          }
        },
        "glow": {
          "type": "object",
          "description": "Hyprland's inner window glow: decoration:glow:* in ConfigValues.cpp at v0.57.2. It is a focus cue, not decoration for its own sake, so the colour is an accent role rather than a fixed hex and the alphas are low enough that the glow reads as light on the edge of the window. enabled defaults to false upstream, which is why the Performance intensity sets it false: the glow is an extra render pass per window, and the fade it arrives with (the fadeGlow animation leaf) is warped to nothing when the intensity turns motion off, which would leave an instant flash instead of a cue. range and render_power carry the MS<Int> bounds Hyprland itself enforces, so a value outside them is a config error in the session rather than a clamp.",
          "required": ["enabled", "range", "render_power", "role", "alpha", "alpha_inactive"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "range": { "type": "integer", "minimum": 0, "maximum": 100 },
            "render_power": { "type": "integer", "minimum": 1, "maximum": 4 },
            "role": { "$ref": "#/definitions/accent_role_name" },
            "alpha": { "$ref": "#/definitions/alpha" },
            "alpha_inactive": { "$ref": "#/definitions/alpha" }
          }
        },
        "window": {
          "type": "object",
          "required": ["active_opacity", "inactive_opacity", "fullscreen_opacity", "dim_inactive", "dim_strength"],
          "additionalProperties": false,
          "properties": {
            "active_opacity": { "$ref": "#/definitions/alpha" },
            "inactive_opacity": { "$ref": "#/definitions/alpha" },
            "fullscreen_opacity": { "$ref": "#/definitions/alpha" },
            "dim_inactive": { "type": "boolean" },
            "dim_strength": { "$ref": "#/definitions/alpha" }
          }
        },
        "terminal": {
          "type": "object",
          "required": ["background_opacity"],
          "additionalProperties": false,
          "properties": {
            "background_opacity": { "$ref": "#/definitions/alpha" }
          }
        },
        "shell": {
          "type": "object",
          "required": ["bar_opacity", "capsule_opacity", "dock_opacity", "notification_opacity", "panel_transparency", "settings_translucent"],
          "additionalProperties": false,
          "properties": {
            "_note": { "type": "string" },
            "bar_opacity": { "$ref": "#/definitions/alpha" },
            "capsule_opacity": { "$ref": "#/definitions/alpha" },
            "dock_opacity": { "$ref": "#/definitions/alpha" },
            "notification_opacity": { "$ref": "#/definitions/alpha" },
            "panel_transparency": { "enum": ["solid", "soft", "glass"] },
            "settings_translucent": { "type": "boolean" }
          }
        },
        "gtk": {
          "type": "object",
          "description": "Fill opacity per GTK surface. A sidebar is always at least as opaque as the window it sits in, so navigation stays readable over a translucent client area; the Performance intensity sets every one of these to 1.0.",
          "required": [
            "window", "headerbar", "sidebar", "popover", "tooltip", "toast",
            "dialog", "input", "button", "card"
          ],
          "additionalProperties": false,
          "properties": {
            "_note": { "type": "string" },
            "window": { "$ref": "#/definitions/alpha" },
            "headerbar": { "$ref": "#/definitions/alpha" },
            "sidebar": {
              "allOf": [{ "$ref": "#/definitions/alpha" }],
              "minimum": 0.5
            },
            "popover": { "$ref": "#/definitions/alpha" },
            "tooltip": { "$ref": "#/definitions/alpha" },
            "toast": { "$ref": "#/definitions/alpha" },
            "dialog": { "$ref": "#/definitions/alpha" },
            "input": { "$ref": "#/definitions/alpha" },
            "button": { "$ref": "#/definitions/alpha" },
            "card": { "$ref": "#/definitions/alpha" }
          }
        },
        "qt": {
          "type": "object",
          "description": "Fill opacity per Qt surface, driving Kvantum's reduce_window_opacity and reduce_menu_opacity. Kvantum's own blurring needs the KDE blur effect, which Hyprland does not provide, so the frosted look comes from these opacities plus the compositor blur in glass.lua; the Performance intensity sets both to 1.0 (opaque).",
          "required": ["window", "menu"],
          "additionalProperties": false,
          "properties": {
            "window": { "$ref": "#/definitions/alpha" },
            "menu": { "$ref": "#/definitions/alpha" }
          }
        },
        "motion": {
          "type": "object",
          "description": "The compositor animation switch for this intensity. enabled=false makes gen_animations_lua.py emit hl.config({ animations = { enabled = false } }), which Hyprland's AnimationManager turns into a warp: every animated variable jumps straight to its final value with no per-frame bezier or spring work (AnimationManager.cpp:279, warp = !*PANIMENABLED || !PAV->enabled()). That is how the Performance intensity measurably lowers compositor work; docs/UNVERIFIED.md PERF-01 records that the frame-time saving was not measured on real hardware. 'preset' names the motion preset this intensity renders from -- a file in data/design/animations/ -- so the Performance profile in Part 3 switches intensity and motion in one step instead of two disagreeing switches. The two keys must agree: enabled=false only with preset 'off', enabled=true only with a preset whose own master switch is on. tests/test_animation_presets.py asserts that pairing, and asserts the 'smooth' preset's curves and durations still equal the global motion block, so an intensity never silently drifts away from the tokens the CSS and Noctalia renderers use.",
          "required": ["enabled", "preset"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "preset": { "enum": ["smooth", "snappy", "bouncy", "minimal", "off"] }
          }
        }
      }
    }
  }
}
